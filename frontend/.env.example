# Frontend environment variables (Vite). Copy to frontend/.env and fill in.

# API base URL. Leave unset in local dev to use the Vite proxy (/api -> :3001).
# VITE_API_URL=https://reframevisuals.com/api

# Google OAuth — Portal "Sign in with Google".
# OAuth 2.0 Web Client ID from https://console.cloud.google.com.
# Must match the backend GOOGLE_CLIENT_ID. Authorized JavaScript origins must
# include http://localhost:5173 (dev) and https://reframevisuals.com (prod).
VITE_GOOGLE_CLIENT_ID=

# Plausible Analytics (self-hosted). See scripts/plausible-setup.md for deployment steps.
VITE_PLAUSIBLE_HOST=http://YOUR_SERVER_IP:8001
VITE_PLAUSIBLE_DOMAIN=reframevisuals.com
VITE_PLAUSIBLE_SHARED_AUTH=
