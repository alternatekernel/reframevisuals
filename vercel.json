{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["sin1"],
  "trailingSlash": false,
  "installCommand": "npm install && npm install --prefix frontend && npm install --prefix backend",
  "buildCommand": "npm run db:generate && npm run build --prefix frontend",
  "outputDirectory": "frontend/dist",
  "functions": {
    "api/index.ts": { "maxDuration": 60, "includeFiles": "backend/{prisma,src}/**" }
  },
  "redirects": [
    { "source": "/:path*", "has": [{ "type": "host", "value": "www.reframevisuals.com" }], "destination": "https://reframevisuals.com/:path*", "statusCode": 301 },
    { "source": "/services/jewelry-retouch", "destination": "/jewelry-photo-retouching-service", "statusCode": 301 },
    { "source": "/insights/:slug", "destination": "/blog/:slug", "statusCode": 301 },
    { "source": "/insights", "destination": "/blog", "statusCode": 301 }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/dashboard/(.*)", "destination": "/index.csr.html" },
    { "source": "/dashboard", "destination": "/index.csr.html" },
    { "source": "/admin/(.*)", "destination": "/index.csr.html" },
    { "source": "/admin", "destination": "/index.csr.html" },
    { "source": "/portal/(.*)", "destination": "/index.csr.html" },
    { "source": "/portal", "destination": "/index.csr.html" },
    { "source": "/order/(.*)", "destination": "/index.csr.html" },
    { "source": "/order", "destination": "/index.csr.html" },
    { "source": "/p/(.*)", "destination": "/index.csr.html" },
    { "source": "/login", "destination": "/index.csr.html" },
    { "source": "/signup", "destination": "/index.csr.html" },
    { "source": "/forgot-password", "destination": "/index.csr.html" },
    { "source": "/reset-password", "destination": "/index.csr.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Strict-Transport-Security", "value": "max-age=63072000; includeSubDomains; preload" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), hid=(), bluetooth=()" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ]
}
