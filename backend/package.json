{
  "name": "reframe-backend",
  "version": "1.0.0",
  "description": "Express.js backend for Reframe Visual CMS",
  "main": "dist/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "nodemon --exec tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "npx tsx src/database/seed.ts",
    "db:seed-orders": "npx tsx src/database/seed-orders.ts",
    "db:cleanup-guests": "npx tsx src/scripts/cleanupGuests.ts",
    "db:migrate-insights": "npx tsx src/scripts/migrate-insights.ts",
    "postinstall": "prisma generate"
  },
  "keywords": [
    "cms",
    "express",
    "react"
  ],
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.11",
    "@types/nodemailer": "^8.0.0",
    "@vercel/functions": "^3.9.11",
    "archiver": "^7.0.1",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.0",
    "express-validator": "^7.0.1",
    "form-data": "^4.0.0",
    "google-auth-library": "^10.7.0",
    "helmet": "^8.1.0",
    "imapflow": "^1.4.7",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.1",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "prisma": "^5.22.0",
    "resend": "^6.12.3",
    "sanitize-html": "^2.17.3",
    "stripe": "^22.1.0",
    "telegraf": "^4.16.3",
    "tsx": "^4.7.1",
    "typescript": "^5.3.3"
  },
  "devDependencies": {
    "@types/archiver": "^6.0.4",
    "@types/morgan": "^1.9.10",
    "@types/node": "^25.9.1",
    "@types/sanitize-html": "^2.16.1",
    "nodemon": "^3.1.14",
    "vitest": "^3.2.4"
  }
}
