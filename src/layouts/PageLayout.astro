---
import BaseLayout from './BaseLayout.astro'
import Nav from '../components/nav/Nav.astro'
import Footer from '../components/nav/Footer.astro'
import MobileStickyContact from '../components/common/MobileStickyContact.astro'

interface Props {
  title: string
  description?: string
  canonical?: string
  ogImage?: string
  noIndex?: boolean
  jsonLd?: object | object[]
  noMobileBar?: boolean
  class?: string
}

const {
  title,
  description,
  canonical,
  ogImage,
  noIndex,
  jsonLd,
  noMobileBar = false,
  class: className,
} = Astro.props
---

<BaseLayout {title} {description} {canonical} {ogImage} {noIndex} {jsonLd}>
  <slot name="head" slot="head" />

  <Nav />

  <main id="main-content" class:list={['page-main', className]}>
    <slot />
  </main>

  <Footer />

  {!noMobileBar && <MobileStickyContact />}
</BaseLayout>

<style>
.page-main {
  min-height: 60vh;
}
</style>
