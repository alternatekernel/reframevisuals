---
import Logo from '../ui/Logo.astro'

const LINK_GROUPS = [
  {
    title: 'Services',
    links: [
      { label: 'Background Removal', href: '/services/foundation/background-removal' },
      { label: 'Color Correction',   href: '/services/enhancement/color-correction' },
      { label: 'Shadow Effects',     href: '/services/foundation/shadow-effects' },
      { label: 'Retouching',         href: '/services/retouch/product-retouching' },
      { label: 'All Services',       href: '/services' },
    ],
  },
  {
    title: 'Company',
    links: [
      { label: 'About',        href: '/about' },
      { label: 'Portfolio',    href: '/portfolio' },
      { label: 'Case Studies', href: '/case-studies' },
      { label: 'Blog',         href: '/blog' },
      { label: 'Contact',      href: '/contact' },
    ],
  },
  {
    title: 'Platform',
    links: [
      { label: 'How It Works',     href: '/how-it-works' },
      { label: 'Pricing',          href: '/pricing' },
      { label: 'Free Trial',       href: '/free-trial' },
      { label: 'Book Meeting',     href: '/book-meeting' },
      { label: 'AI Product Visuals', href: '/ai-product-visuals' },
    ],
  },
  {
    title: 'Legal',
    links: [
      { label: 'Privacy Policy', href: '/legal/privacy' },
      { label: 'Terms of Use',   href: '/legal/terms' },
      { label: 'Cookie Policy',  href: '/legal/cookies' },
      { label: 'Quality SLA',    href: '/trust/quality-assurance' },
      { label: 'Turnaround SLA', href: '/trust/turnaround-sla' },
    ],
  },
]

const SOCIALS = [
  { platform: 'Instagram',  href: 'https://www.instagram.com/reframevisualsstudio/', icon: 'instagram' },
  { platform: 'LinkedIn',   href: 'https://www.linkedin.com/company/reframe-visuals/', icon: 'linkedin' },
  { platform: 'Pinterest',  href: 'https://www.pinterest.com/reframevisuals/', icon: 'pinterest' },
  { platform: 'Behance',    href: 'https://www.behance.net/reframevisuals', icon: 'behance' },
  { platform: 'X / Twitter',href: 'https://x.com/ReframeVisual', icon: 'x' },
]

const appUrl = import.meta.env.PUBLIC_APP_URL ?? 'https://app.reframevisuals.com'
const year   = new Date().getFullYear()
---

<footer class="footer">
  <!-- CTA bar -->
  <div class="footer-cta-bar">
    <div class="section-container">
      <div class="footer-cta-bar__inner">
        <div class="footer-cta-bar__copy">
          <h3 class="footer-cta-bar__headline">Start with 3 free edits.</h3>
          <p class="footer-cta-bar__sub">Hand-traced edges. Two-stage QA. No minimum order.</p>
        </div>
        <a href="/free-trial" class="footer-cta-bar__btn">
          Get 3 Free Sample Edits
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
        </a>
      </div>
    </div>
  </div>

  <!-- Main grid -->
  <div class="footer-main">
    <div class="section-container">
      <div class="footer-grid">
        <!-- Brand column -->
        <div class="footer-brand">
          <Logo light />
          <p class="footer-brand__desc">
            Professional photo editing for e-commerce brands — background removal, colour correction, retouching, and beyond.
          </p>
          <div class="footer-socials">
            {SOCIALS.map(({ platform, href, icon }) => (
              <a
                href={href}
                class="footer-social"
                aria-label={platform}
                target="_blank"
                rel="noopener noreferrer"
              >
                {icon === 'instagram' && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/></svg>}
                {icon === 'linkedin'  && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>}
                {icon === 'x'        && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2H21.5l-7.1 8.114L22.75 22h-6.54l-5.121-6.712L5.206 22H1.95l7.59-8.674L1.5 2h6.707l4.63 6.119L18.244 2Zm-1.146 18h1.804L7.285 3.896H5.349L17.098 20Z"/></svg>}
                {icon === 'pinterest'&& <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.04 2C6.55 2 3 5.7 3 10.38c0 2.17 1.2 4.87 3.13 5.72.29.13.45.07.52-.2.05-.2.31-1.23.43-1.7.04-.15.02-.29-.1-.44-.64-.78-1.15-2.2-1.15-3.54 0-3.26 2.47-6.4 6.68-6.4 3.64 0 6.18 2.48 6.18 6.03 0 4-2.02 6.78-4.65 6.78-1.45 0-2.54-1.2-2.19-2.67.42-1.75 1.23-3.64 1.23-4.9 0-1.13-.61-2.08-1.87-2.08-1.48 0-2.67 1.53-2.67 3.59 0 1.31.44 2.19.44 2.19l-1.8 7.61c-.31 1.3-.19 3.12-.05 4.3.04.34.49.46.66.17.63-1.03 1.65-2.78 1.99-4.04.12-.46.63-2.39.63-2.39.56 1.06 2.19 1.95 3.92 1.95 5.16 0 8.88-4.74 8.88-10.63C23.22 5.21 18.92 2 12.04 2Z"/></svg>}
                {icon === 'behance'  && <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 6h6.2c2.48 0 4.02 1.16 4.02 3.08 0 1.16-.53 2-1.55 2.5 1.34.38 2.09 1.43 2.09 2.96 0 2.2-1.78 3.46-4.47 3.46H3V6Zm5.83 4.75c1.05 0 1.65-.45 1.65-1.25s-.56-1.2-1.67-1.2H5.8v2.45h3.03Zm.25 4.95c1.22 0 1.9-.5 1.9-1.43 0-.92-.68-1.42-1.95-1.42H5.8v2.85h3.28ZM16.25 7.2h5.4v1.45h-5.4V7.2Zm2.75 3.15c2.7 0 4.25 1.72 4.25 4.6v.58h-6.06c.17 1.13.84 1.74 1.96 1.74.82 0 1.36-.31 1.66-.93h2.28c-.54 1.77-2.03 2.86-3.99 2.86-2.64 0-4.27-1.73-4.27-4.42 0-2.64 1.68-4.43 4.17-4.43Zm1.87 3.68c-.13-1.03-.76-1.6-1.81-1.6-1.02 0-1.68.58-1.86 1.6h3.67Z"/></svg>}
              </a>
            ))}
          </div>
        </div>

        <!-- Link groups — desktop -->
        <div class="footer-links-desktop">
          {LINK_GROUPS.map(({ title, links }) => (
            <div class="footer-link-group">
              <h5 class="footer-link-group__title">{title}</h5>
              <ul class="footer-link-group__list">
                {links.map(({ label, href }) => (
                  <li>
                    <a href={href} class="footer-link">
                      <span class="footer-link__dot"></span>
                      <span>{label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        <!-- Link groups — mobile accordion (no JS — uses details/summary) -->
        <div class="footer-links-mobile">
          {LINK_GROUPS.map(({ title, links }) => (
            <details class="footer-accordion">
              <summary class="footer-accordion__trigger">
                <span>{title}</span>
                <svg class="footer-accordion__chevron" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
              </summary>
              <ul class="footer-accordion__links">
                {links.map(({ label, href }) => (
                  <li>
                    <a href={href} class="footer-accordion__link">{label}</a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom">
    <div class="section-container">
      <div class="footer-bottom__inner">
        <p class="footer-bottom__copy">© {year} Reframe Visuals. All rights reserved.</p>
        <div class="footer-bottom__links">
          <a href="/legal/privacy" class="footer-bottom__link">Privacy</a>
          <a href="/legal/terms"   class="footer-bottom__link">Terms</a>
          <a href="/legal/cookies" class="footer-bottom__link">Cookies</a>
        </div>
      </div>
    </div>
  </div>
</footer>

<style>
.footer {
  background: var(--footer-dark);
  color: #ffffff;
  overflow: hidden;
  border-top: 1px solid rgba(255,255,255,0.06);
}

/* ── CTA bar ────────────────────────────────────────────── */
.footer-cta-bar {
  padding: 2rem 0;
  border-bottom: 1px solid rgba(255,255,255,0.08);
}
@media (min-width: 640px) { .footer-cta-bar { padding: 3rem 0; } }

.footer-cta-bar__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  gap: 1.5rem;
  text-align: center;
}
@media (min-width: 1024px) {
  .footer-cta-bar__inner { flex-direction: row; text-align: left; }
}

.footer-cta-bar__headline {
  font-family: var(--font-heading);
  font-size: 1.5rem;
  font-weight: 700;
  line-height: 1.2;
  margin-bottom: 0.375rem;
}
@media (min-width: 640px) { .footer-cta-bar__headline { font-size: 1.875rem; } }

.footer-cta-bar__sub {
  color: rgba(255,255,255,0.50);
  font-size: 0.9375rem;
}

.footer-cta-bar__btn {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 1.5rem;
  height: 3rem;
  border-radius: var(--radius-pill);
  background: #ffffff;
  color: var(--color-text-primary);
  font-size: 0.875rem;
  font-weight: 600;
  white-space: nowrap;
  flex-shrink: 0;
  transition: background var(--transition-fast), color var(--transition-fast);
}
.footer-cta-bar__btn:hover { background: var(--color-bg-secondary); }

/* ── Main grid ──────────────────────────────────────────── */
.footer-main {
  padding: 2rem 0;
}
@media (min-width: 640px) { .footer-main { padding: 4rem 0; } }

.footer-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 2rem;
}
@media (min-width: 768px) {
  .footer-grid { grid-template-columns: 1fr 2fr; }
}

/* ── Brand column ───────────────────────────────────────── */
.footer-brand {
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.footer-brand__desc {
  color: rgba(255,255,255,0.50);
  font-size: 0.9375rem;
  line-height: 1.6;
  max-width: 20rem;
}

.footer-socials {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem;
}

.footer-social {
  width: 2.75rem;
  height: 2.75rem;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 9999px;
  background: rgba(255,255,255,0.05);
  border: 1px solid rgba(255,255,255,0.10);
  color: rgba(255,255,255,0.65);
  transition: background var(--transition-base), border-color var(--transition-base), color var(--transition-base);
}
.footer-social:hover {
  background: var(--brand);
  border-color: var(--brand);
  color: #ffffff;
}

/* ── Link groups desktop ────────────────────────────────── */
.footer-links-desktop {
  display: none;
  grid-template-columns: repeat(4, 1fr);
  gap: 1.5rem;
}
@media (min-width: 768px) { .footer-links-desktop { display: grid; } }

.footer-link-group__title {
  font-family: var(--font-heading);
  font-size: 0.75rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.12em;
  color: rgba(255,255,255,0.60);
  margin-bottom: 1rem;
}

.footer-link-group__list {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}

.footer-link {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  min-height: 2rem;
  font-size: 0.875rem;
  color: rgba(255,255,255,0.55);
  transition: color var(--transition-fast), transform var(--transition-fast);
}
.footer-link:hover {
  color: #ffffff;
  transform: translateX(4px);
}

.footer-link__dot {
  width: 6px;
  height: 6px;
  border-radius: 9999px;
  background: rgba(255,255,255,0.20);
  flex-shrink: 0;
  transition: background var(--transition-fast);
}
.footer-link:hover .footer-link__dot { background: var(--brand); }

/* ── Link groups mobile accordion ───────────────────────── */
.footer-links-mobile {
  display: flex;
  flex-direction: column;
  gap: 0.375rem;
}
@media (min-width: 768px) { .footer-links-mobile { display: none; } }

.footer-accordion {
  border: 1px solid rgba(255,255,255,0.10);
  border-radius: 0.5rem;
  background: rgba(255,255,255,0.02);
}

.footer-accordion__trigger {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0.875rem 1rem;
  cursor: pointer;
  list-style: none;
  font-size: 0.6875rem;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.14em;
  color: rgba(255,255,255,0.55);
  user-select: none;
}
.footer-accordion__trigger::-webkit-details-marker { display: none; }

.footer-accordion__chevron {
  transition: transform var(--transition-fast);
}
details[open] .footer-accordion__chevron { transform: rotate(180deg); }

.footer-accordion__links {
  list-style: none;
  padding: 0 1rem 1rem;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 0.25rem;
}

.footer-accordion__link {
  display: block;
  padding: 0.5rem 0;
  font-size: 0.875rem;
  color: rgba(255,255,255,0.55);
  transition: color var(--transition-fast);
}
.footer-accordion__link:hover { color: #ffffff; }

/* ── Bottom bar ─────────────────────────────────────────── */
.footer-bottom {
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 1.25rem 0;
}

.footer-bottom__inner {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0.75rem;
  text-align: center;
}
@media (min-width: 640px) {
  .footer-bottom__inner { flex-direction: row; justify-content: space-between; text-align: left; }
}

.footer-bottom__copy {
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.35);
}

.footer-bottom__links {
  display: flex;
  gap: 1.25rem;
}

.footer-bottom__link {
  font-size: 0.8125rem;
  color: rgba(255,255,255,0.35);
  transition: color var(--transition-fast);
}
.footer-bottom__link:hover { color: rgba(255,255,255,0.75); }
</style>
