---
/**
 * BeatPixelzBanner — ported from BeatPixelzBanner.tsx
 * CTA banner: "Better edges than AI tools. Lower price than enterprise studios."
 * Two CTAs: Get 3 Free Sample Edits + See pricing.
 */
---

<section class="bpb-section">
  <div class="bpb-outer">
    <div class="bpb-card">
      <!-- Decorative blurs -->
      <div class="bpb-blur bpb-blur--tr" aria-hidden="true"></div>
      <div class="bpb-blur bpb-blur--bl" aria-hidden="true"></div>

      <!-- Copy -->
      <div class="bpb-copy">
        <h2 class="bpb-heading">
          Better edges than AI tools. Lower price than enterprise studios.{' '}
          <span class="bpb-heading-muted">From $0.39/image.</span>
        </h2>
        <p class="bpb-subtext">Human QA, cleaner edges, and per-image pricing with no subscription.</p>
      </div>

      <!-- CTAs -->
      <div class="bpb-ctas">
        <a href="/free-trial?type=pilot" class="bpb-btn bpb-btn--primary">
          <span>Get 3 Free Sample Edits</span>
          <span class="bpb-btn__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </a>
        <a href="/pricing" class="bpb-btn bpb-btn--secondary">See pricing</a>
      </div>
    </div>
  </div>
</section>

<style>
.bpb-section {
  position: relative;
  overflow: hidden;
}

.bpb-outer {
  position: relative;
  z-index: 10;
  max-width: 80rem;
  margin: 0 auto;
  padding: 1.75rem 1.25rem;
}
@media (min-width: 640px) { .bpb-outer { padding: 2rem 2rem; } }
@media (min-width: 1024px) { .bpb-outer { padding: 2.25rem 2.5rem; } }

.bpb-card {
  position: relative;
  overflow: hidden;
  border-radius: 1.75rem;
  border: 1px solid rgba(0,0,0,0.08);
  background: linear-gradient(135deg, #fafafa 0%, #f5f5f0 50%, #fafafa 100%);
  padding: 1.25rem;
  box-shadow: 0 24px 60px -34px rgba(15,23,42,0.18);
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}
@media (min-width: 640px) { .bpb-card { padding: 1.5rem; } }
@media (min-width: 1024px) {
  .bpb-card {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 2.5rem;
    padding: 1.75rem 2rem;
  }
}

.bpb-blur {
  pointer-events: none;
  position: absolute;
  width: 9rem;
  height: 9rem;
  border-radius: 50%;
}
.bpb-blur--tr { top: -2.5rem; right: -2.5rem; background: rgba(255,255,255,0.55); filter: blur(2rem); }
.bpb-blur--bl { bottom: -3rem; left: -2rem; background: rgba(0,0,0,0.03); filter: blur(2rem); }

.bpb-copy { position: relative; z-index: 10; }

.bpb-heading {
  font-family: var(--font-heading);
  font-size: clamp(1.375rem, 3vw, 1.875rem);
  font-weight: 700;
  line-height: 1.2;
  letter-spacing: -0.03em;
  color: var(--color-text-primary);
}

.bpb-heading-muted { color: rgba(0,0,0,0.35); }

.bpb-subtext {
  margin-top: 0.375rem;
  font-size: 1rem;
  line-height: 1.6;
  color: rgba(0,0,0,0.55);
}

.bpb-ctas {
  position: relative;
  z-index: 10;
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
  flex-shrink: 0;
}
@media (min-width: 640px) { .bpb-ctas { flex-direction: row; } }
@media (min-width: 1024px) { .bpb-ctas { flex-direction: column; align-items: stretch; } }

.bpb-btn {
  display: inline-flex;
  min-height: 3rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  white-space: nowrap;
  border-radius: 9999px;
  font-size: 1rem;
  font-weight: 700;
  text-decoration: none;
  transition: background 0.2s, transform 0.1s;
}
.bpb-btn:active { transform: scale(0.95); }

.bpb-btn--primary {
  background: var(--color-text-primary);
  color: #fff;
  padding: 0.375rem 0.375rem 0.375rem 1.5rem;
  box-shadow: 0 8px 24px rgba(0,0,0,0.10);
}
.bpb-btn--primary:hover { background: #000; }

.bpb-btn__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: rgba(255,255,255,0.90);
  color: #000;
  flex-shrink: 0;
  transition: transform 0.3s;
}
.bpb-btn--primary:hover .bpb-btn__arrow { transform: rotate(-45deg); }

.bpb-btn--secondary {
  background: #fff;
  color: var(--color-text-primary);
  border: 1px solid rgba(0,0,0,0.10);
  padding: 0 1.5rem;
}
.bpb-btn--secondary:hover { background: rgba(0,0,0,0.03); }
</style>
