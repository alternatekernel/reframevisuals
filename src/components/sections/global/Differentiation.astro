---
/**
 * Differentiation — faithfully ported from Differentiation.tsx
 * Two-column: left = copy with price callout + decorative logo; right = transformation cards.
 * Each card: pastel icon (blue/rose/amber/yellow/teal/purple per index),
 * point.old (strikethrough, dimmed) → point.new (bold).
 */

interface DiffPoint {
  old: string
  new: string
}

interface Props {
  heading?: string
  subheading?: string
  points?: DiffPoint[]
}

const {
  heading = 'Where standard services fail.',
  subheading = 'How we handle it differently.',
  points = [
    { old: 'AI drops lace, glass, hair, and transparent edges', new: 'Hand-traced pen tool paths on every complex edge' },
    { old: 'Offshore services race on price, lose on consistency', new: 'Dedicated editor team with a shared style guide per client' },
    { old: 'Flat-looking ghost mannequin with visible seams', new: 'Natural hollow-man composite that sells the garment shape' },
    { old: 'White background only, no variation options', new: 'Any background: white, custom color, lifestyle, gradient' },
    { old: 'Enterprise studios with monthly minimums you can\'t fill', new: 'Per-image pricing from $0.39 — no contract, no minimum' },
    { old: 'Days of back-and-forth over revisions', new: 'Unlimited revisions included — delivered correct the first time' },
  ],
} = Astro.props

// Pastel card color system matches getCardStyles() in Differentiation.tsx
const CARD_COLORS = [
  { bg: 'rgba(239,246,255,0.5)', border: 'rgba(191,219,254,0.5)', iconBg: 'rgba(219,234,254,0.6)', iconColor: '#2563EB', icon: 'M13 10V3L4 14h7v7l9-11h-7z' },
  { bg: 'rgba(255,241,242,0.5)', border: 'rgba(254,205,211,0.5)', iconBg: 'rgba(254,226,226,0.6)', iconColor: '#E11D48', icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z' },
  { bg: 'rgba(255,251,235,0.5)', border: 'rgba(253,230,138,0.5)', iconBg: 'rgba(254,243,199,0.6)', iconColor: '#D97706', icon: 'M8.21 13.89L7 23l5-3 5 3-1.21-9.12 M15.91 9.11A4.08 4.08 0 0 0 12 8a4 4 0 1 0 3.91 1.11z' },
  { bg: 'rgba(254,252,232,0.5)', border: 'rgba(253,224,71,0.5)', iconBg: 'rgba(254,249,195,0.6)', iconColor: '#CA8A04', icon: 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z' },
  { bg: 'rgba(240,253,250,0.5)', border: 'rgba(153,246,228,0.5)', iconBg: 'rgba(204,251,241,0.6)', iconColor: '#0D9488', icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75' },
  { bg: 'rgba(250,245,255,0.5)', border: 'rgba(233,213,255,0.5)', iconBg: 'rgba(243,232,255,0.6)', iconColor: '#7C3AED', icon: 'M23 6l-9.5 9.5-5-5L1 18 M17 6h6v6' },
]
---

<section class="diff-section">
  <div class="diff-container">

    <div class="diff-grid">
      <!-- Left: copy column -->
      <div class="diff-left reveal">
        <h2 class="diff-heading">
          {heading} <br />
          <span class="diff-heading-muted">{subheading}</span>
        </h2>

        <div class="diff-body">
          <p class="diff-body-primary">
            Automated tools drop <strong>lace, glass, hair, and transparent edges</strong>. Offshore services race on price and lose on consistency. Enterprise studios charge monthly minimums most catalogs can't fill. We trace complex edges by hand, match your style guide, and price per image.
          </p>
          <p class="diff-body-callout">
            <strong>Pen Tool tracing on every path.</strong> Guaranteed turnaround windows. No contracts. Send 3 images free before your first paid order.
          </p>
          <div class="diff-price-wrap">
            <!-- Decorative logo overlay -->
            <div class="diff-logo-overlay" aria-hidden="true">
              <img src="/logo.svg" alt="" class="diff-logo-img" />
            </div>
            <p class="diff-price-text">
              Per-image pricing from $0.39, with no contract and no minimum order.
            </p>
          </div>
        </div>
      </div>

      <!-- Right: transformation cards -->
      <div class="diff-right reveal">
        <div class="diff-cards-wrap">
          <div class="diff-cards">
            {points.map((point, i) => {
              const c = CARD_COLORS[i % CARD_COLORS.length]
              return (
                <div
                  class="diff-card"
                  style={`--card-bg:${c.bg}; --card-border:${c.border}; --icon-bg:${c.iconBg}; --icon-color:${c.iconColor}; --delay:${i * 0.04}s`}
                >
                  <!-- Pastel icon -->
                  <div class="diff-card__icon" aria-hidden="true">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      {c.icon.split(' M').map((seg, si) => (
                        <path d={si === 0 ? seg : 'M' + seg} />
                      ))}
                    </svg>
                  </div>
                  <!-- Text: old → new -->
                  <div class="diff-card__text">
                    <p class="diff-card__old">{point.old}</p>
                    <p class="diff-card__new">{point.new}</p>
                  </div>
                </div>
              )
            })}
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<style>
.diff-section {
  padding: 3.5rem 1.5rem;
  background: var(--color-bg-primary);
}
@media (min-width: 640px) { .diff-section { padding: 4rem 1.5rem; } }
@media (min-width: 1024px) { .diff-section { padding: 6rem 3rem; } }

.diff-container {
  max-width: 72rem;
  margin: 0 auto;
}

.diff-grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 1.25rem;
}
@media (min-width: 640px) { .diff-grid { gap: 2rem; } }
@media (min-width: 1024px) {
  .diff-grid {
    grid-template-columns: 1fr 1.2fr;
    gap: 6rem;
    align-items: center;
  }
}

/* Left column */
.diff-left {}

.diff-heading {
  font-family: var(--font-heading);
  font-size: clamp(1.75rem, 4vw, 3rem);
  font-weight: 800;
  letter-spacing: -0.04em;
  line-height: 1.1;
  color: var(--color-text-primary);
  margin-bottom: 0.75rem;
}
@media (min-width: 640px) { .diff-heading { margin-bottom: 1rem; } }

.diff-heading-muted { color: rgba(0,0,0,0.40); }

.diff-body { display: flex; flex-direction: column; gap: 0.75rem; }
@media (min-width: 640px) { .diff-body { gap: 1rem; } }
@media (min-width: 1024px) { .diff-body { gap: 1.5rem; } }

.diff-body-primary {
  max-width: 34ch;
  font-size: 0.9375rem;
  color: rgba(0,0,0,0.60);
  line-height: 1.55;
}
@media (min-width: 640px) {
  .diff-body-primary { max-width: none; font-size: 1rem; line-height: 1.6; }
}

.diff-body-callout {
  display: none;
  font-size: 0.875rem;
  color: rgba(0,0,0,0.70);
  line-height: 1.55;
  border-left: 2px solid rgba(0,0,0,0.20);
  padding-left: 0.75rem;
}
@media (min-width: 640px) {
  .diff-body-callout { display: block; font-size: 1rem; padding-left: 1.25rem; }
}

.diff-price-wrap {
  display: none;
  position: relative;
}
@media (min-width: 640px) { .diff-price-wrap { display: block; } }

.diff-logo-overlay {
  display: none;
}
@media (min-width: 640px) {
  .diff-logo-overlay {
    display: block;
    position: absolute;
    top: -3rem;
    left: -5rem;
    width: 12rem;
    height: 12rem;
    pointer-events: none;
    opacity: 0.05;
    z-index: 0;
  }
}

.diff-logo-img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transform: rotate(-12deg);
}

.diff-price-text {
  position: relative;
  z-index: 10;
  font-size: 1rem;
  font-weight: 700;
  color: var(--color-text-primary);
}
@media (min-width: 640px) { .diff-price-text { font-size: 1.125rem; } }

/* Right column */
.diff-cards-wrap {
  border-radius: 1.75rem;
  border: 1px solid rgba(0,0,0,0.10);
  background: #FAFAFA;
  padding: 0.625rem;
  box-shadow: 0 18px 60px -48px rgba(0,0,0,0.5);
}
@media (min-width: 640px) { .diff-cards-wrap { padding: 1rem; } }

.diff-cards {
  display: flex;
  flex-direction: column;
  gap: 0.625rem;
}
@media (min-width: 640px) { .diff-cards { gap: 0.75rem; } }

.diff-card {
  display: grid;
  grid-template-columns: auto 1fr;
  gap: 0.75rem;
  align-items: start;
  border-radius: 1rem;
  border: 1px solid var(--card-border);
  background: var(--card-bg);
  padding: 0.75rem;
  transition: transform 0.3s;
  animation-delay: var(--delay, 0s);
}
.diff-card:hover { transform: translateY(-2px); }
@media (min-width: 640px) { .diff-card { padding: 1.25rem; } }

.diff-card__icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 2.5rem;
  height: 2.5rem;
  flex-shrink: 0;
  border-radius: 1rem;
  border: 1px solid rgba(0,0,0,0.05);
  background: var(--icon-bg);
  color: var(--icon-color);
  transition: background 0.3s, color 0.3s;
}
@media (min-width: 640px) { .diff-card__icon { width: 2.75rem; height: 2.75rem; } }

.diff-card__text { display: flex; flex-direction: column; gap: 0.25rem; }

.diff-card__old {
  font-size: 0.75rem;
  font-weight: 600;
  line-height: 1.35;
  color: rgba(0,0,0,0.35);
  text-decoration: line-through;
}
@media (min-width: 640px) { .diff-card__old { font-size: 0.9375rem; } }

.diff-card__new {
  font-size: 0.875rem;
  font-weight: 700;
  line-height: 1.35;
  letter-spacing: -0.015em;
  color: var(--color-text-primary);
}
@media (min-width: 640px) { .diff-card__new { font-size: 1.125rem; } }
</style>
