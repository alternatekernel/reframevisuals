---
/**
 * TrialAuditCta — ported from TrialAuditCta.tsx
 * Email capture CTA card with blue-tinted border, decorative blurs.
 * Form submits GET to /free-trial with ?email= param (no JS state needed).
 */
---

<section class="tac-section" aria-label="Free trial CTA">
  <div class="tac-container">
    <div class="tac-card reveal">
      <!-- Decorative blurs -->
      <div class="tac-blur tac-blur--tr" aria-hidden="true"></div>
      <div class="tac-blur tac-blur--bl" aria-hidden="true"></div>

      <h3 class="tac-heading">See the edit quality before you pay.</h3>
      <p class="tac-subtext">Submit your images. We'll edit them and send back the before/after.</p>

      <form class="tac-form" action="/free-trial" method="GET">
        <input
          type="email"
          name="email"
          placeholder="Enter your work email"
          required
          autocomplete="email"
          class="tac-input"
          aria-label="Work email address"
        />
        <button type="submit" class="tac-submit">
          <span>Get 3 Free Sample Edits</span>
          <span class="tac-submit__arrow" aria-hidden="true">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </span>
        </button>
      </form>

      <div class="tac-reassurances" aria-label="Reassurances">
        <span>Replies within 30 min</span>
        <span class="tac-dot" aria-hidden="true">•</span>
        <span>No spam, ever</span>
        <span class="tac-dot" aria-hidden="true">•</span>
        <span>Editor on every image</span>
      </div>
    </div>
  </div>
</section>

<style>
.tac-section {
  padding: 1rem 1.5rem 2.5rem;
}
@media (min-width: 1024px) { .tac-section { padding: 1.25rem 2.5rem 3rem; } }

.tac-container {
  max-width: 48rem;
  margin: 0 auto;
  text-align: center;
}

.tac-card {
  position: relative;
  overflow: hidden;
  border-radius: 1.75rem;
  border: 1px solid rgba(186,230,253,0.80);
  background: linear-gradient(135deg, #fafafa 0%, #f0f9ff 50%, #fafafa 100%);
  padding: 1.25rem;
  box-shadow: 0 18px 48px rgba(15,23,42,0.08);
  display: flex;
  flex-direction: column;
  gap: 1rem;
}
@media (min-width: 640px) { .tac-card { padding: 1.75rem; } }

.tac-blur {
  pointer-events: none;
  position: absolute;
  width: 9rem;
  height: 9rem;
  border-radius: 50%;
}
.tac-blur--tr { top: -2.5rem; right: -2.5rem; background: rgba(255,255,255,0.55); filter: blur(2rem); }
.tac-blur--bl { bottom: -3rem; left: -2rem; background: rgba(191,219,254,0.35); filter: blur(2rem); }

.tac-heading {
  position: relative;
  z-index: 10;
  font-family: var(--font-heading);
  font-size: clamp(1.375rem, 3vw, 1.75rem);
  font-weight: 600;
  line-height: 1.15;
  letter-spacing: -0.025em;
  color: var(--color-text-primary);
}

.tac-subtext {
  position: relative;
  z-index: 10;
  font-size: 0.9375rem;
  font-weight: 500;
  line-height: 1.6;
  color: rgba(0,0,0,0.70);
  max-width: 36rem;
  margin: 0 auto;
}

.tac-form {
  position: relative;
  z-index: 10;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.625rem;
  width: 100%;
  max-width: 36rem;
  margin: 0.5rem auto 0;
}
@media (min-width: 640px) {
  .tac-form {
    grid-template-columns: 1fr auto;
    align-items: stretch;
  }
}

.tac-input {
  min-height: 3rem;
  border-radius: 9999px;
  border: 1px solid rgba(0,0,0,0.12);
  background: rgba(255,255,255,0.95);
  padding: 0 1.25rem;
  font-size: 0.9375rem;
  font-family: var(--font-body);
  color: var(--color-text-primary);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  width: 100%;
}
.tac-input::placeholder { color: rgba(0,0,0,0.40); }
.tac-input:focus {
  border-color: rgba(0,0,0,0.30);
  box-shadow: 0 0 0 3px rgba(0,0,0,0.06);
}

.tac-submit {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  min-height: 3rem;
  border-radius: 9999px;
  background: var(--color-text-primary);
  color: #fff;
  padding: 0.375rem 0.375rem 0.375rem 1.5rem;
  font-size: 0.9375rem;
  font-weight: 700;
  font-family: var(--font-body);
  border: none;
  cursor: pointer;
  white-space: nowrap;
  box-shadow: 0 8px 24px rgba(0,0,0,0.10);
  transition: background 0.2s, transform 0.1s;
  touch-action: manipulation;
}
.tac-submit:hover { background: #000; }
.tac-submit:active { transform: scale(0.95); }

.tac-submit__arrow {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 2rem;
  height: 2rem;
  border-radius: 50%;
  background: rgba(255,255,255,0.90);
  color: #000;
  flex-shrink: 0;
  transition: transform 0.3s;
}
.tac-submit:hover .tac-submit__arrow { transform: rotate(-45deg); }

.tac-reassurances {
  position: relative;
  z-index: 10;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
  gap: 0.375rem 1rem;
  font-size: 0.8125rem;
  font-weight: 500;
  color: rgba(0,0,0,0.70);
}

.tac-dot {
  color: rgba(0,0,0,0.25);
  display: none;
}
@media (min-width: 640px) { .tac-dot { display: inline; } }
</style>
