---
/**
 * PreFooterCTA — conversion strip above the footer.
 * Variants: default (brand gradient) | dark | light.
 * All tokens wired — change --brand in tokens.css to retheme instantly.
 */
interface Props {
  headline?: string
  sub?: string
  primaryLabel?: string
  primaryHref?: string
  secondaryLabel?: string
  secondaryHref?: string
  variant?: 'brand' | 'dark' | 'light'
  trustPoints?: string[]
}

const {
  headline      = 'Start with 3 free edits. No credit card needed.',
  sub           = 'Hand-traced edges. Two-stage QA. 24-hour delivery on your first batch.',
  primaryLabel  = 'Get 3 Free Sample Edits',
  primaryHref   = '/free-trial',
  secondaryLabel = 'Book a discovery call',
  secondaryHref  = '/book-meeting',
  variant        = 'brand',
  trustPoints    = ['Hand-traced Pen Tool edges', 'Manual QA on every image', 'No minimum order', '24h turnaround'],
} = Astro.props
---

<section class={`prefooter-cta prefooter-cta--${variant} reveal`} aria-label="Call to action">
  <div class="section-container prefooter-cta__inner">
    <div class="prefooter-cta__copy">
      <h2 class="prefooter-cta__headline">{headline}</h2>
      <p class="prefooter-cta__sub">{sub}</p>
      <div class="prefooter-cta__trust">
        {trustPoints.map(pt => (
          <span class="prefooter-cta__trust-item">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true"><path d="m5 13 4 4L19 7"/></svg>
            {pt}
          </span>
        ))}
      </div>
    </div>
    <div class="prefooter-cta__actions">
      <a href={primaryHref} class="prefooter-cta__primary">
        {primaryLabel}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
      <a href={secondaryHref} class="prefooter-cta__secondary">{secondaryLabel}</a>
    </div>
  </div>
</section>

<style>
.prefooter-cta {
  padding: 5rem 0;
  position: relative;
  overflow: hidden;
}

/* ── Variants ───────────────────────────────────────────── */
.prefooter-cta--brand {
  background: linear-gradient(135deg, var(--brand) 0%, #5B21B6 100%);
  color: #ffffff;
}
.prefooter-cta--dark {
  background: var(--footer-dark);
  color: #ffffff;
}
.prefooter-cta--light {
  background: var(--color-bg-secondary);
  color: var(--color-text-primary);
  border-top: 1px solid var(--color-border-subtle);
  border-bottom: 1px solid var(--color-border-subtle);
}

/* ── Layout ─────────────────────────────────────────────── */
.prefooter-cta__inner {
  display: flex;
  flex-direction: column;
  gap: 2.5rem;
  align-items: flex-start;
}
@media (min-width: 1024px) {
  .prefooter-cta__inner {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
  }
}

/* ── Copy ────────────────────────────────────────────────── */
.prefooter-cta__headline {
  font-family: var(--font-heading);
  font-size: clamp(1.75rem, 3.5vw, 2.75rem);
  font-weight: 800;
  letter-spacing: -0.03em;
  line-height: 1.15;
  max-width: 28rem;
}

.prefooter-cta__sub {
  margin-top: 0.75rem;
  font-size: var(--text-body);
  line-height: 1.6;
  max-width: 32rem;
  opacity: 0.80;
}

.prefooter-cta__trust {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  margin-top: 1.25rem;
}

.prefooter-cta__trust-item {
  display: flex;
  align-items: center;
  gap: 0.375rem;
  font-size: 0.8125rem;
  font-weight: 500;
  opacity: 0.75;
}

/* ── Actions ─────────────────────────────────────────────── */
.prefooter-cta__actions {
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
  flex-shrink: 0;
}
@media (min-width: 480px) {
  .prefooter-cta__actions { flex-direction: row; align-items: center; }
}

.prefooter-cta__primary {
  display: inline-flex;
  align-items: center;
  gap: 0.5rem;
  padding: 0 1.75rem;
  height: 3.25rem;
  border-radius: var(--radius-pill);
  font-weight: 700;
  font-size: 0.9375rem;
  white-space: nowrap;
  transition: opacity var(--transition-fast), transform var(--transition-fast);
}
.prefooter-cta--brand .prefooter-cta__primary,
.prefooter-cta--dark  .prefooter-cta__primary {
  background: #ffffff;
  color: var(--color-text-primary);
}
.prefooter-cta--light .prefooter-cta__primary {
  background: var(--brand);
  color: #ffffff;
}
.prefooter-cta__primary:hover {
  opacity: 0.92;
  transform: translateY(-1px);
}

.prefooter-cta__secondary {
  display: inline-flex;
  align-items: center;
  height: 3.25rem;
  padding: 0 1.25rem;
  font-size: 0.875rem;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  white-space: nowrap;
  transition: opacity var(--transition-fast);
}
.prefooter-cta--brand .prefooter-cta__secondary,
.prefooter-cta--dark  .prefooter-cta__secondary {
  color: rgba(255,255,255,0.75);
}
.prefooter-cta--light .prefooter-cta__secondary {
  color: var(--color-text-secondary);
}
.prefooter-cta__secondary:hover { opacity: 1; }
</style>
