---
/**
 * TargetAudienceProof — ported from TargetAudienceProof.tsx
 * 3 audience segments: Ecommerce sellers / Amazon sellers / Startup & scaling brands.
 * Eyebrow + headline + CTA link per card.
 */

const SEGMENTS = [
  {
    eyebrow: 'Ecommerce sellers',
    headline: 'Quality without\nenterprise commitments.',
    cta: { label: 'Get 3 free edits', href: '/free-trial' },
  },
  {
    eyebrow: 'Amazon sellers',
    headline: 'Listing images that pass\ncompliance and drive clicks.',
    cta: { label: 'See how it works', href: '/how-it-works' },
  },
  {
    eyebrow: 'Startup & scaling brands',
    headline: 'Test quality before\nyou commit to anyone.',
    cta: { label: 'Start test batch', href: '/free-trial?type=pilot' },
  },
]
---

<section class="tap-section reveal" aria-label="Who we serve">
  <div class="tap-container">
    <h2 class="tap-heading">
      The same editing quality, without{' '}
      <span class="tap-heading-muted">the enterprise minimums.</span>
    </h2>

    <div class="tap-grid">
      {SEGMENTS.map((seg) => (
        <div class="tap-card">
          <p class="tap-eyebrow">{seg.eyebrow}</p>
          <h3 class="tap-card-headline">{seg.headline}</h3>
          <a href={seg.cta.href} class="tap-cta">
            <span class="tap-cta__label">{seg.cta.label}</span>
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="tap-cta__arrow" aria-hidden="true">
              <line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/>
            </svg>
          </a>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
.tap-section {
  padding: 2.5rem 1.25rem 1rem;
}
@media (min-width: 1024px) { .tap-section { padding: 4rem 2.5rem 1.5rem; } }

.tap-container {
  max-width: 80rem;
  margin: 0 auto;
}

.tap-heading {
  font-family: var(--font-heading);
  font-size: clamp(2rem, 4.5vw, 3.125rem);
  font-weight: 600;
  letter-spacing: -0.04em;
  line-height: 1.05;
  color: var(--color-text-primary);
  text-align: center;
  margin-bottom: 2rem;
}
@media (min-width: 1024px) { .tap-heading { margin-bottom: 3rem; } }

.tap-heading-muted { color: rgba(0,0,0,0.40); }

.tap-grid {
  display: grid;
  gap: 1rem;
}
@media (min-width: 768px) { .tap-grid { grid-template-columns: repeat(3, 1fr); gap: 1.5rem; } }

.tap-card {
  display: flex;
  flex-direction: column;
  padding: 0.5rem 0;
  text-align: center;
  gap: 0.75rem;
}

.tap-eyebrow {
  font-size: 0.6875rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.18em;
  color: rgba(0,0,0,0.40);
}

.tap-card-headline {
  flex: 1;
  white-space: pre-line;
  font-family: var(--font-heading);
  font-size: clamp(1.375rem, 2.5vw, 1.625rem);
  font-weight: 600;
  letter-spacing: -0.03em;
  line-height: 1.15;
  color: var(--color-text-primary);
}

.tap-cta {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 0.375rem;
  font-size: 0.9375rem;
  font-weight: 700;
  color: var(--color-text-primary);
  text-decoration: none;
  transition: gap 0.2s;
  margin-top: 0.75rem;
}

.tap-cta__label {
  position: relative;
}
.tap-cta__label::after {
  content: '';
  position: absolute;
  left: 0; right: 0; bottom: -1px;
  height: 1px;
  background: currentColor;
  opacity: 0;
  transform: scaleX(0);
  transform-origin: left;
  transition: opacity 0.2s, transform 0.25s;
}
.tap-cta:hover .tap-cta__label::after {
  opacity: 0.5;
  transform: scaleX(1);
}

.tap-cta__arrow {
  color: rgba(0,0,0,0.40);
  transition: transform 0.3s, color 0.2s;
  flex-shrink: 0;
}
.tap-cta:hover .tap-cta__arrow {
  transform: rotate(-45deg);
  color: rgba(0,0,0,0.70);
}
</style>
