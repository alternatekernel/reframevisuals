---
/**
 * Workflow — 4-step process section.
 * Token-wired. Steps are props so any page can customise them.
 * Reveal animation via IntersectionObserver (.reveal class).
 */
interface Step {
  number: string
  title: string
  description: string
  icon?: 'upload' | 'scope' | 'edit' | 'deliver'
}

interface Props {
  title?: string
  subtitle?: string
  steps?: Step[]
  variant?: 'light' | 'dark'
}

const {
  title = 'How it works',
  subtitle = 'From raw files to catalog-ready images in 12–72 hours.',
  variant = 'light',
  steps = [
    {
      number: '01',
      icon: 'upload',
      title: 'Upload & Connect',
      description: 'Drop files manually, share a Google Drive link, or connect Dropbox/Amazon Seller Central. Our systems fetch your raw assets instantly — no new software to install.',
    },
    {
      number: '02',
      icon: 'scope',
      title: 'Scoping & Quote',
      description: 'Within 15–30 minutes our team reviews your files for complexity. You get a transparent, binding quote before a single pixel is touched. No hidden fees.',
    },
    {
      number: '03',
      icon: 'edit',
      title: 'Human + AI Editing',
      description: 'Human editors use the Pen Tool on every clipping path. AI handles repetitive steps; editors verify every shadow, texture, and edge before moving to QA.',
    },
    {
      number: '04',
      icon: 'deliver',
      title: 'QA & Delivery',
      description: 'Two editors review each file independently. Then your images land in your dashboard for approval. Revisions are same-day and covered by our quality SLA.',
    },
  ],
} = Astro.props

const ICONS: Record<string, string> = {
  upload:  '<path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="17 8 12 3 7 8"/><line x1="12" y1="3" x2="12" y2="15"/>',
  scope:   '<circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/>',
  edit:    '<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>',
  deliver: '<polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/>',
}
---

<section class={`workflow workflow--${variant} reveal`} aria-label="How Reframe Visuals works">
  <div class="section-container">
    <div class="workflow__header">
      <h2 class="workflow__title">{title}</h2>
      <p class="workflow__subtitle">{subtitle}</p>
    </div>

    <ol class="workflow__steps" role="list">
      {steps.map((step, i) => (
        <li class="workflow-step reveal" style={`--delay:${i * 80}ms`}>
          <div class="workflow-step__num-wrap">
            <span class="workflow-step__num">{step.number}</span>
            {i < steps.length - 1 && <div class="workflow-step__connector" aria-hidden="true" />}
          </div>
          <div class="workflow-step__body">
            {step.icon && ICONS[step.icon] && (
              <div class="workflow-step__icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" set:html={ICONS[step.icon]} />
              </div>
            )}
            <h3 class="workflow-step__title">{step.title}</h3>
            <p class="workflow-step__desc">{step.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
.workflow {
  padding: 5rem 0;
}
.workflow--dark {
  background: var(--footer-dark);
  color: #ffffff;
}
.workflow--light {
  background: var(--color-bg-primary);
}

.workflow__header {
  max-width: 40rem;
  margin-bottom: 3rem;
}

.workflow__title {
  font-family: var(--font-heading);
  font-size: clamp(var(--text-heading-3), 3vw, var(--text-heading-2));
  font-weight: 800;
  letter-spacing: -0.03em;
  color: var(--color-text-primary);
}
.workflow--dark .workflow__title { color: #ffffff; }

.workflow__subtitle {
  margin-top: 0.75rem;
  font-size: var(--text-body);
  color: var(--color-text-secondary);
}
.workflow--dark .workflow__subtitle { color: rgba(255,255,255,0.55); }

/* ── Steps grid ─────────────────────────────────────────── */
.workflow__steps {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0;
}
@media (min-width: 768px) {
  .workflow__steps {
    grid-template-columns: repeat(2, 1fr);
    gap: 2rem 3rem;
  }
  .workflow-step__connector { display: none; }
}
@media (min-width: 1200px) {
  .workflow__steps { grid-template-columns: repeat(4, 1fr); }
}

/* ── Single step ─────────────────────────────────────────── */
.workflow-step {
  display: flex;
  gap: 1.25rem;
  padding: 1.75rem 0;
  border-bottom: 1px solid var(--color-border-subtle);
}
@media (min-width: 768px) {
  .workflow-step {
    flex-direction: column;
    gap: 1rem;
    padding: 0;
    border-bottom: none;
  }
}

.workflow-step__num-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 0;
  flex-shrink: 0;
}
@media (min-width: 768px) {
  .workflow-step__num-wrap { flex-direction: row; }
}

.workflow-step__num {
  width: 2.5rem;
  height: 2.5rem;
  border-radius: 9999px;
  border: 1.5px solid var(--brand);
  display: flex;
  align-items: center;
  justify-content: center;
  font-family: var(--font-heading);
  font-size: 0.8125rem;
  font-weight: 700;
  color: var(--brand);
  flex-shrink: 0;
}

.workflow-step__connector {
  width: 1.5px;
  flex: 1;
  min-height: 2rem;
  background: var(--color-border-light);
  margin: 0.375rem auto;
}

.workflow-step__body {
  display: flex;
  flex-direction: column;
  gap: 0.5rem;
}

.workflow-step__icon {
  width: 2rem;
  height: 2rem;
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--brand);
}

.workflow-step__title {
  font-family: var(--font-heading);
  font-size: 1.0625rem;
  font-weight: 700;
  color: var(--color-text-primary);
}
.workflow--dark .workflow-step__title { color: #ffffff; }

.workflow-step__desc {
  font-size: 0.875rem;
  line-height: 1.65;
  color: var(--color-text-secondary);
}
.workflow--dark .workflow-step__desc { color: rgba(255,255,255,0.55); }
</style>
