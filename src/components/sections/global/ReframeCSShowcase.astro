---
/**
 * ReframeCSShowcase — ported from ReframeCSShowcase.tsx
 * Section showcasing the ReframeCS chat widget features.
 * 6 feature cards + header section.
 */

const FEATURE_ITEMS = [
  {
    iconPath: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
    title: 'Skip email loops',
    text: 'Direct support chat without inbox delays.',
  },
  {
    iconPath: 'M9 11l3 3L22 4 M21 12v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11',
    title: 'Place and manage orders',
    text: 'Start new orders and track progress live.',
  },
  {
    iconPath: 'M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4 M17 8l-5-5-5 5 M12 3v12',
    title: 'Upload files',
    text: 'Drag & drop images, briefs, and references.',
  },
  {
    iconPath: 'M3 18v-6a9 9 0 0 1 18 0v6 M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z',
    title: 'Support anytime',
    text: 'Instant human help for any project updates.',
  },
  {
    iconPath: 'M20 3H4a1 1 0 0 0-1 1v13a1 1 0 0 0 1 1h16a1 1 0 0 0 1-1V4a1 1 0 0 0-1-1z M8 21h8 M12 17v4',
    title: 'Desktop app coming soon',
    text: 'Stay connected with native apps for macOS and Windows.',
  },
  {
    iconPath: 'M12 2a2 2 0 0 1 2 2c0 .74-.4 1.39-1 1.73V7h1a7 7 0 0 1 7 7h1a1 1 0 0 1 1 1v3a1 1 0 0 1-1 1h-1v1a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-1H1a1 1 0 0 1-1-1v-3a1 1 0 0 1 1-1h1a7 7 0 0 1 7-7h1V5.73c-.6-.34-1-.99-1-1.73a2 2 0 0 1 2-2z',
    title: 'AI Agent Ready',
    text: 'Your AI agent can interact and manage orders.',
  },
]
---

<section class="rcs-section" aria-label="ReframeCS — customer support platform">
  <!-- Header -->
  <div class="rcs-header">
    <div class="rcs-header__logo-bg" aria-hidden="true">
      <img src="/logo.svg" alt="" aria-hidden="true" class="rcs-header__logo-img" loading="lazy" />
    </div>
    <div class="rcs-header__inner reveal">
      <h2 class="rcs-heading">Need help with your order?</h2>
      <p class="rcs-subheading">Live support preview, right on the page.</p>
    </div>
  </div>

  <!-- Feature grid -->
  <div class="rcs-features reveal">
    {FEATURE_ITEMS.map((item) => (
      <div class="rcs-feat">
        <div class="rcs-feat__icon-wrap" aria-hidden="true">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" class="rcs-feat__icon">
            {item.iconPath.split(' M').map((seg: string, si: number) => (
              <path d={si === 0 ? seg : 'M' + seg} />
            ))}
          </svg>
        </div>
        <div>
          <h3 class="rcs-feat__title">{item.title}</h3>
          <p class="rcs-feat__text">{item.text}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
.rcs-section {
  background: var(--color-bg-primary);
  border-bottom: 1px solid rgba(0,0,0,0.06);
}

/* Header */
.rcs-header {
  position: relative;
  overflow: hidden;
  padding: 2rem 1.25rem 2rem;
  border-bottom: 1px solid #f5f5f5;
  text-align: center;
}
@media (min-width: 640px) { .rcs-header { padding: 2.5rem 1.5rem; } }

.rcs-header__logo-bg {
  pointer-events: none;
  position: absolute;
  top: 50%;
  left: 0;
  transform: translate(-50%, -50%);
  opacity: 0.02;
}
.rcs-header__logo-img { width: 16.25rem; height: 16.25rem; }
@media (min-width: 640px) { .rcs-header__logo-img { width: 26.25rem; height: 26.25rem; } }

.rcs-header__inner {
  position: relative;
  z-index: 10;
  max-width: 56rem;
  margin: 0 auto;
  padding: 0 1rem;
}

.rcs-heading {
  font-family: var(--font-heading);
  font-size: clamp(1.75rem, 4vw, 2.75rem);
  font-weight: 700;
  letter-spacing: -0.04em;
  line-height: 1.1;
  color: var(--color-text-primary);
  margin-bottom: 1rem;
}

.rcs-subheading {
  font-size: clamp(0.9375rem, 2vw, 1.125rem);
  color: rgba(0,0,0,0.55);
  line-height: 1.6;
  max-width: 40rem;
  margin: 0 auto;
}

/* Feature grid */
.rcs-features {
  max-width: 64rem;
  margin: 0 auto;
  padding: 2rem 1.25rem 3rem;
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}
@media (min-width: 640px) { .rcs-features { grid-template-columns: repeat(2, 1fr); padding: 2.5rem 1.5rem 3.5rem; } }
@media (min-width: 1024px) { .rcs-features { grid-template-columns: repeat(3, 1fr); padding: 3rem 2.5rem 4rem; } }

.rcs-feat {
  display: flex;
  align-items: flex-start;
  gap: 0.875rem;
  padding: 1rem;
  border-radius: var(--radius-md, 1rem);
  border: 1px solid rgba(0,0,0,0.10);
  background: #fff;
  box-shadow: 0 1px 6px rgba(0,0,0,0.04);
  transition: border-color 0.2s, box-shadow 0.2s;
}
.rcs-feat:hover {
  border-color: rgba(0,0,0,0.20);
  box-shadow: 0 4px 16px rgba(0,0,0,0.06);
}

.rcs-feat__icon-wrap {
  flex-shrink: 0;
  width: 2.25rem;
  height: 2.25rem;
  border-radius: 0.625rem;
  border: 1px solid rgba(0,0,0,0.10);
  background: #fafafa;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rcs-feat__icon { color: rgba(0,0,0,0.80); }

.rcs-feat__title {
  font-size: 0.9375rem;
  font-weight: 700;
  letter-spacing: -0.02em;
  color: var(--color-text-primary);
  margin-bottom: 0.25rem;
}

.rcs-feat__text {
  font-size: 0.8125rem;
  color: rgba(0,0,0,0.55);
  line-height: 1.5;
}
</style>
