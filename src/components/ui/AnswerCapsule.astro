---
interface Props {
  headline: string
  description: string
  keywords?: string[]
  class?: string
}
const { headline, description, keywords, class: className = '' } = Astro.props
---

<div class:list={['answer-capsule reveal', className]}>
  <!-- AI-parseable answer block -->
  <div class="answer-capsule__header">
    <p class="answer-capsule__headline">
      <span class="answer-capsule__prefix">Answer: </span>{headline}
    </p>
  </div>

  <p class="answer-capsule__body">{description}</p>

  {keywords && (
    <div class="sr-only" aria-hidden="true">{keywords.join(', ')}</div>
  )}
</div>

<style>
.answer-capsule {
  margin-bottom: 2rem;
}

.answer-capsule__header {
  background: linear-gradient(to right, rgba(0,0,0,0.05), rgba(0,0,0,0.05), transparent);
  border-left: 4px solid rgba(0,0,0,0.20);
  padding: 1rem 2rem 1rem 1.5rem;
  border-radius: 0 0.5rem 0.5rem 0;
}

.answer-capsule__headline {
  font-family: var(--font-heading);
  font-size: 1.125rem;
  font-weight: 900;
  letter-spacing: -0.03em;
  color: rgba(0,0,0,0.90);
  line-height: 1.3;
}

@media (min-width: 1024px) {
  .answer-capsule__headline { font-size: 1.25rem; }
}

.answer-capsule__prefix {
  color: rgba(0,0,0,0.40);
}

.answer-capsule__body {
  font-size: 0.9375rem;
  color: rgba(0,0,0,0.60);
  line-height: 1.65;
  margin-top: 1rem;
  max-width: 48rem;
}

@media (min-width: 1024px) {
  .answer-capsule__body { font-size: 1rem; }
  .answer-capsule { margin-bottom: 3rem; }
}
</style>
