---
interface NavLink {
  label: string
  href: string
}

interface Props {
  title?: string
  exclude?: string
}

const { title = 'Explore Next', exclude = Astro.url.pathname } = Astro.props

const ALL_LINKS: NavLink[] = [
  { label: 'Services',      href: '/services' },
  { label: 'Pricing',       href: '/pricing' },
  { label: 'About',         href: '/about' },
  { label: 'Portfolio',     href: '/portfolio' },
  { label: 'Blog',          href: '/blog' },
  { label: 'Case Studies',  href: '/case-studies' },
  { label: 'How It Works',  href: '/how-it-works' },
]

const isActive = (href: string) => {
  if (href === '/blog') return exclude === '/blog' || exclude.startsWith('/blog/')
  return exclude === href || exclude.startsWith(`${href}/`)
}

const links = ALL_LINKS.filter((l) => !isActive(l.href)).slice(0, 4)
---

<section class="continue-browsing">
  <div class="section-container">
    <h2 class="continue-browsing__title">{title}</h2>
    <div class="continue-browsing__grid">
      {links.map((link) => (
        <a href={link.href} class="continue-browsing__card">
          {link.label}
        </a>
      ))}
    </div>
  </div>
</section>

<style>
.continue-browsing {
  padding-bottom: 4rem;
}

.continue-browsing__title {
  font-family: var(--font-heading);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 1rem;
}

.continue-browsing__grid {
  display: grid;
  grid-template-columns: 1fr;
  gap: 0.75rem;
}

@media (min-width: 640px) {
  .continue-browsing__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (min-width: 1024px) {
  .continue-browsing__grid { grid-template-columns: repeat(4, 1fr); }
}

.continue-browsing__card {
  display: block;
  border-radius: 0.5rem;
  padding: 0.75rem 1rem;
  font-size: 0.875rem;
  font-weight: 500;
  color: rgba(0,0,0,0.85);
  border: 1px solid rgba(0,0,0,0.10);
  background: var(--color-bg-primary);
  box-shadow: var(--shadow-resting);
  transition: box-shadow var(--transition-base), border-color var(--transition-base), transform var(--transition-base);
}

.continue-browsing__card:hover {
  border-color: rgba(0,0,0,0.20);
  box-shadow: var(--shadow-card);
  transform: translateY(-2px);
}
</style>
