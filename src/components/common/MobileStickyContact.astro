---
// Shown only on mobile, hidden on /free-trial
---

<div class="mobile-sticky-contact" id="mobile-sticky-contact">
  <div class="mobile-sticky-contact__inner">
    <a href="/contact" class="mobile-sticky-contact__btn mobile-sticky-contact__btn--outline">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
      Reframe CS
    </a>
    <a href="/book-meeting" class="mobile-sticky-contact__btn mobile-sticky-contact__btn--dark">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      Book meeting
    </a>
  </div>
</div>

<style>
.mobile-sticky-contact {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 220;
  border-top: 1px solid rgba(0,0,0,0.10);
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(8px);
  -webkit-backdrop-filter: blur(8px);
  padding-bottom: max(env(safe-area-inset-bottom), 8px);
}

@media (min-width: 768px) {
  .mobile-sticky-contact { display: none; }
}

.mobile-sticky-contact__inner {
  display: flex;
  gap: 0.5rem;
  max-width: 36rem;
  margin: 0 auto;
  padding: 0.5rem;
}

.mobile-sticky-contact__btn {
  display: flex;
  flex: 1;
  height: 2.75rem;
  align-items: center;
  justify-content: center;
  gap: 0.5rem;
  border-radius: 0.75rem;
  font-size: 0.8125rem;
  font-weight: 600;
  font-family: var(--font-body);
  text-decoration: none;
  transition: opacity var(--transition-fast);
}
.mobile-sticky-contact__btn:active { opacity: 0.85; }

.mobile-sticky-contact__btn--outline {
  border: 1px solid rgba(0,0,0,0.10);
  color: var(--color-text-primary);
  background: transparent;
}

.mobile-sticky-contact__btn--dark {
  background: var(--color-text-primary);
  color: #ffffff;
  border: none;
}
</style>
