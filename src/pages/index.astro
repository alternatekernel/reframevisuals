---
import PageLayout from '../layouts/PageLayout.astro'
import StatsBar from '../components/sections/global/StatsBar.astro'
import Testimonials from '../components/sections/global/Testimonials.astro'
import PreFooter from '../components/sections/global/PreFooter.astro'
import Faq from '../components/sections/global/Faq.astro'
import Workflow from '../components/sections/global/Workflow.astro'
import Differentiation from '../components/sections/global/Differentiation.astro'
import ClientCategoryStrip from '../components/sections/global/ClientCategoryStrip.astro'
import InsightsPreview from '../components/sections/global/InsightsPreview.astro'

---

<PageLayout
  title="Reframe Visuals — Professional Photo Editing for E-Commerce"
  description="Hand-traced background removal, colour correction, and product retouching. Start with 3 free sample edits. No minimum order."
>
  <!-- Placeholder hero -->
  <section style="padding: 8rem 1.5rem; text-align: center; background: var(--color-bg-primary);">
    <h1 style="font-family: var(--font-heading); font-size: var(--text-heading-1); font-weight: 800; letter-spacing: -0.04em; margin-bottom: 1rem;">
      Professional Photo Editing<br/>for E-Commerce
    </h1>
    <p style="color: var(--color-text-secondary); font-size: 1.125rem; max-width: 36rem; margin: 0 auto 2rem;">
      Hand-traced edges. Two-stage QA. Start with 3 free sample edits.
    </p>
    <a href="/free-trial" class="btn-primary">Get 3 Free Sample Edits</a>
  </section>

  <ClientCategoryStrip />
  <StatsBar />
  <Differentiation />
  <Workflow />
  <Testimonials />
  <InsightsPreview />
  <Faq />
  <PreFooter />
</PageLayout>
