---
import PageLayout from '../layouts/PageLayout.astro'
import Hero from '../components/sections/global/Hero.astro'
import BeatPixelzBanner from '../components/sections/global/BeatPixelzBanner.astro'
import ClientCategoryStrip from '../components/sections/global/ClientCategoryStrip.astro'
import Testimonials from '../components/sections/global/Testimonials.astro'
import Workflow from '../components/sections/global/Workflow.astro'
import TargetAudienceProof from '../components/sections/global/TargetAudienceProof.astro'
import TrialAuditCta from '../components/sections/global/TrialAuditCta.astro'
import ReframeCSShowcase from '../components/sections/global/ReframeCSShowcase.astro'
import StatsBar from '../components/sections/global/StatsBar.astro'
import InsightsPreview from '../components/sections/global/InsightsPreview.astro'
import Differentiation from '../components/sections/global/Differentiation.astro'
import Faq from '../components/sections/global/Faq.astro'
import PreFooter from '../components/sections/global/PreFooter.astro'
---

<PageLayout
  title="Reframe Visuals — Professional Photo Editing for E-Commerce"
  description="Hand-traced background removal, colour correction, and product retouching. Start with 3 free sample edits. No minimum order."
>
  <!-- 1. Hero -->
  <Hero />

  <!-- 2. Client / platform strip (trust signals) -->
  <ClientCategoryStrip />

  <!-- 3. Beat Pixelz CTA banner -->
  <BeatPixelzBanner />

  <!-- 4. Differentiation feature grid -->
  <Differentiation />

  <!-- 5. Testimonials marquee -->
  <Testimonials />

  <!-- 6. Free-trial email CTA -->
  <TrialAuditCta />

  <!-- 7. Workflow diagram -->
  <Workflow />

  <!-- 8. Target audience proof (3 segments) -->
  <TargetAudienceProof />

  <!-- 9. Stats bar (count-up numbers) -->
  <StatsBar />

  <!-- 10. ReframeCS support showcase -->
  <ReframeCSShowcase />

  <!-- 11. Insights / blog preview -->
  <InsightsPreview />

  <!-- 12. FAQ -->
  <Faq />

  <!-- 13. Pre-footer image -->
  <PreFooter />
</PageLayout>
