---
import BaseLayout from '../layouts/BaseLayout.astro'
---

<BaseLayout title="Design System — Reframe Visuals">
  <div class="ds-shell">

    <!-- ══ SIDEBAR ══════════════════════════════════════════════ -->
    <nav class="ds-nav" aria-label="Design system sections">
      <div class="ds-nav__logo">
        <img src="/logo.svg" alt="Reframe Visuals" height="22" />
        <span>Design System</span>
      </div>
      <ul>
        <li><a href="#colors">Colors</a></li>
        <li><a href="#typography">Typography</a></li>
        <li><a href="#shadows">Shadows</a></li>
        <li><a href="#radius">Border Radius</a></li>
        <li><a href="#buttons">Buttons</a></li>
        <li><a href="#cards">Cards</a></li>
        <li><a href="#badges">Badges &amp; Labels</a></li>
        <li><a href="#inputs">Inputs</a></li>
        <li><a href="#animations">Animations</a></li>
        <li><a href="#glass">Glass &amp; FX</a></li>
      </ul>
    </nav>

    <!-- ══ MAIN CONTENT ═════════════════════════════════════════ -->
    <main class="ds-main" id="main-content">

      <header class="ds-page-header">
        <p class="label-ui">Reframe Visuals</p>
        <h1>Design System</h1>
        <p class="ds-page-header__sub">
          Live reference — every swatch, token and component is rendered from the actual CSS.
          Edit <code>src/styles/tokens.css</code> or <code>src/styles/patterns.css</code> and this page updates instantly.
        </p>
      </header>

      <!-- ── COLORS ──────────────────────────────────────────── -->
      <section id="colors" class="ds-section">
        <h2 class="ds-section__title">Colors</h2>

        <h3 class="ds-group-title">Brand</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--brand)"></div>
            <code>--brand</code>
            <span>#7C3AED</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--brand-hover)"></div>
            <code>--brand-hover</code>
            <span>#6D28D9</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--onyx)"></div>
            <code>--onyx</code>
            <span>#0A0A0B</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--soft-black)"></div>
            <code>--soft-black</code>
            <span>#1F1F1F</span>
          </div>
        </div>

        <h3 class="ds-group-title">Text</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--color-text-primary)"></div>
            <code>--color-text-primary</code>
            <span>#171717</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--color-text-secondary)"></div>
            <code>--color-text-secondary</code>
            <span>#666666</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--color-text-muted)"></div>
            <code>--color-text-muted</code>
            <span>#808080</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-text-body)"></div>
            <code>--color-text-body</code>
            <span>rgb(0 0 0 / .55)</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-text-faint)"></div>
            <code>--color-text-faint</code>
            <span>rgb(0 0 0 / .35)</span>
          </div>
        </div>

        <h3 class="ds-group-title">Backgrounds</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-bg-primary)"></div>
            <code>--color-bg-primary</code>
            <span>#ffffff</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-bg-secondary)"></div>
            <code>--color-bg-secondary</code>
            <span>#fafafa</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--footer-dark)"></div>
            <code>--footer-dark</code>
            <span>#050505</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--accent-lavender)"></div>
            <code>--accent-lavender</code>
            <span>#FFFBF5</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-bg-input)"></div>
            <code>--color-bg-input</code>
            <span>#F3F4F6</span>
          </div>
        </div>

        <h3 class="ds-group-title">Borders</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-border-subtle)"></div>
            <code>--color-border-subtle</code>
            <span>#f5f5f5</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-border-light)"></div>
            <code>--color-border-light</code>
            <span>#eaeaea</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-border)"></div>
            <code>--color-border</code>
            <span>rgb(0 0 0 / .10)</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-border-medium)"></div>
            <code>--color-border-medium</code>
            <span>rgb(0 0 0 / .15)</span>
          </div>
        </div>

        <h3 class="ds-group-title">Service Categories</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--cat-foundation)"></div>
            <code>--cat-foundation</code>
            <span>Foundation · #EA580C</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--cat-enhancement)"></div>
            <code>--cat-enhancement</code>
            <span>Enhancement · #0284C7</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--cat-retouch)"></div>
            <code>--cat-retouch</code>
            <span>Retouch · #16A34A</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--cat-advanced)"></div>
            <code>--cat-advanced</code>
            <span>Advanced · #7C3AED</span>
          </div>
        </div>

        <h3 class="ds-group-title">Status</h3>
        <div class="swatch-grid">
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--color-success)"></div>
            <code>--color-success</code>
            <span>#16A34A</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-success-bg)"></div>
            <code>--color-success-bg</code>
            <span>#F0FDF4</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip" style="background:var(--color-error)"></div>
            <code>--color-error</code>
            <span>#DC2626</span>
          </div>
          <div class="swatch">
            <div class="swatch__chip swatch__chip--bordered" style="background:var(--color-error-bg)"></div>
            <code>--color-error-bg</code>
            <span>#FEF2F2</span>
          </div>
        </div>
      </section>

      <!-- ── TYPOGRAPHY ──────────────────────────────────────── -->
      <section id="typography" class="ds-section">
        <h2 class="ds-section__title">Typography</h2>

        <div class="ds-token-row">
          <span class="ds-token-label">Heading font</span>
          <span style="font-family:var(--font-heading); font-size:1.125rem;">Space Grotesk Variable — The quick brown fox</span>
        </div>
        <div class="ds-token-row">
          <span class="ds-token-label">Body font</span>
          <span style="font-family:var(--font-body); font-size:1rem;">Satoshi Variable — The quick brown fox</span>
        </div>

        <div class="ds-type-scale">
          <div class="ds-type-row">
            <code class="ds-type-token">--text-hero / 3.8125rem</code>
            <span style="font-size:var(--text-hero); font-family:var(--font-heading); letter-spacing:-0.02em; line-height:1.05;">Hero</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-heading-1 / 3.0625rem</code>
            <span style="font-size:var(--text-heading-1); font-family:var(--font-heading); letter-spacing:-0.02em; line-height:1.1;">Heading 1</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-heading-2 / 2.4375rem</code>
            <span style="font-size:var(--text-heading-2); font-family:var(--font-heading); letter-spacing:-0.02em; line-height:1.2;">Heading 2</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-heading-3 / 1.9375rem</code>
            <span style="font-size:var(--text-heading-3); font-family:var(--font-heading); letter-spacing:-0.02em; line-height:1.25;">Heading 3</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-heading-4 / 1.5625rem</code>
            <span style="font-size:var(--text-heading-4); font-family:var(--font-heading); letter-spacing:-0.02em; line-height:1.3;">Heading 4</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-body-lg / 1.25rem</code>
            <span style="font-size:var(--text-body-lg); font-family:var(--font-body);">Body Large — Reframe Visuals edits your product images.</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-body / 1rem</code>
            <span style="font-size:var(--text-body); font-family:var(--font-body);">Body — Reframe Visuals edits your product images at scale.</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-body-sm / 0.9375rem</code>
            <span style="font-size:var(--text-body-sm); font-family:var(--font-body); color:var(--color-text-secondary);">Body Small — Reframe Visuals edits your product images at scale.</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">--text-caption / 0.75rem</code>
            <span style="font-size:var(--text-caption); font-family:var(--font-body); color:var(--color-text-muted); letter-spacing:0.06em; text-transform:uppercase; font-weight:500;">Caption / Label</span>
          </div>
        </div>

        <h3 class="ds-group-title">Fluid headings</h3>
        <div class="ds-type-scale">
          <div class="ds-type-row">
            <code class="ds-type-token">text-fluid-h1</code>
            <span class="text-fluid-h1" style="font-family:var(--font-heading); letter-spacing:-0.02em;">Fluid H1</span>
          </div>
          <div class="ds-type-row">
            <code class="ds-type-token">text-fluid-h2</code>
            <span class="text-fluid-h2" style="font-family:var(--font-heading); letter-spacing:-0.02em;">Fluid H2</span>
          </div>
        </div>

        <h3 class="ds-group-title">Label UI</h3>
        <div class="ds-demo-row">
          <span class="label-ui">Services</span>
          <span class="label-ui">Case Studies</span>
          <span class="label-ui">How It Works</span>
        </div>
      </section>

      <!-- ── SHADOWS ─────────────────────────────────────────── -->
      <section id="shadows" class="ds-section">
        <h2 class="ds-section__title">Shadows</h2>
        <div class="shadow-grid">
          <div class="shadow-card" style="box-shadow:var(--shadow-resting)">
            <code>--shadow-resting</code>
            <span>Resting state</span>
          </div>
          <div class="shadow-card" style="box-shadow:var(--shadow-card)">
            <code>--shadow-card</code>
            <span>Default card</span>
          </div>
          <div class="shadow-card" style="box-shadow:var(--shadow-hover)">
            <code>--shadow-hover</code>
            <span>Hover / lifted</span>
          </div>
          <div class="shadow-card" style="box-shadow:var(--shadow-hero)">
            <code>--shadow-hero</code>
            <span>Hero element</span>
          </div>
          <div class="shadow-card" style="box-shadow:var(--shadow-lg)">
            <code>--shadow-lg</code>
            <span>Large / modal</span>
          </div>
          <div class="shadow-card" style="box-shadow:var(--shadow-btn)">
            <code>--shadow-btn</code>
            <span>Button</span>
          </div>
        </div>
      </section>

      <!-- ── BORDER RADIUS ───────────────────────────────────── -->
      <section id="radius" class="ds-section">
        <h2 class="ds-section__title">Border Radius</h2>
        <div class="radius-grid">
          <div class="radius-chip" style="border-radius:var(--radius-sm)">
            <code>--radius-sm</code><span>8px</span>
          </div>
          <div class="radius-chip" style="border-radius:var(--radius-md)">
            <code>--radius-md</code><span>16px</span>
          </div>
          <div class="radius-chip" style="border-radius:var(--radius-lg)">
            <code>--radius-lg</code><span>32px</span>
          </div>
          <div class="radius-chip" style="border-radius:var(--radius-card-sm)">
            <code>--radius-card-sm</code><span>20px</span>
          </div>
          <div class="radius-chip" style="border-radius:var(--radius-card)">
            <code>--radius-card</code><span>24px</span>
          </div>
          <div class="radius-chip" style="border-radius:var(--radius-pill)">
            <code>--radius-pill</code><span>9999px</span>
          </div>
        </div>
      </section>

      <!-- ── BUTTONS ──────────────────────────────────────────── -->
      <section id="buttons" class="ds-section">
        <h2 class="ds-section__title">Buttons</h2>

        <h3 class="ds-group-title">Variants</h3>
        <div class="ds-demo-row">
          <button class="btn btn-primary">Primary</button>
          <button class="btn btn-brand">Brand Purple</button>
          <button class="btn btn-secondary">Secondary</button>
          <button class="btn btn-brand-outline">Brand Outline</button>
        </div>

        <h3 class="ds-group-title">Metallic / liquid</h3>
        <div class="ds-demo-row" style="background:var(--footer-dark); padding:1.5rem; border-radius:var(--radius-card);">
          <button class="btn onyx-liquid" style="color:#fff; border:none; border-radius:var(--radius-pill); padding:0 1.5rem; height:3rem; font-family:var(--font-body); font-size:0.875rem; font-weight:500; cursor:pointer;">Onyx Liquid</button>
          <button class="btn amethyst-liquid" style="color:#fff; border:none; border-radius:var(--radius-pill); padding:0 1.5rem; height:3rem; font-family:var(--font-body); font-size:0.875rem; font-weight:500; cursor:pointer;">Amethyst Liquid</button>
        </div>

        <h3 class="ds-group-title">Sizes</h3>
        <div class="ds-demo-row ds-demo-row--align-end">
          <button class="btn btn-primary">Default (48px)</button>
          <button class="btn btn-primary btn-sm">Small (40px)</button>
        </div>

        <h3 class="ds-group-title">States</h3>
        <div class="ds-demo-row">
          <button class="btn btn-primary" disabled>Disabled</button>
          <button class="btn btn-brand" disabled>Disabled Brand</button>
          <button class="btn btn-secondary" disabled>Disabled Secondary</button>
        </div>
      </section>

      <!-- ── CARDS ────────────────────────────────────────────── -->
      <section id="cards" class="ds-section">
        <h2 class="ds-section__title">Cards</h2>

        <div class="card-demo-grid">
          <div class="card-surface" style="padding:1.5rem;">
            <p class="label-ui" style="margin-bottom:0.5rem;">Card Surface</p>
            <h3 style="font-size:var(--text-heading-4); font-family:var(--font-heading); margin-bottom:0.5rem;">Product Editing</h3>
            <p style="color:var(--color-text-secondary); font-size:var(--text-body-sm);">
              Professional photo retouching for e-commerce brands at scale.
            </p>
          </div>

          <div class="card-feature" style="padding:1.5rem;">
            <p class="label-ui" style="margin-bottom:0.5rem;">Card Feature</p>
            <h3 style="font-size:var(--text-heading-4); font-family:var(--font-heading); margin-bottom:0.5rem;">Background Removal</h3>
            <p style="color:var(--color-text-secondary); font-size:var(--text-body-sm);">
              Clean, consistent backgrounds across your entire product catalogue.
            </p>
          </div>

          <div class="card-dark" style="padding:1.5rem;">
            <p class="label-ui" style="margin-bottom:0.5rem; color:rgba(255,255,255,0.45);">Card Dark</p>
            <h3 style="font-size:var(--text-heading-4); font-family:var(--font-heading); color:#fff; margin-bottom:0.5rem;">Dark Surface</h3>
            <p style="color:rgba(255,255,255,0.55); font-size:var(--text-body-sm);">
              Used on the dark footer CTA section.
            </p>
          </div>
        </div>
      </section>

      <!-- ── BADGES & LABELS ─────────────────────────────────── -->
      <section id="badges" class="ds-section">
        <h2 class="ds-section__title">Badges &amp; Labels</h2>
        <div class="ds-demo-row">
          <span class="badge">Default</span>
          <span class="badge-brand">Brand</span>
          <span class="badge" style="background:rgba(234,88,12,.08); border-color:rgba(234,88,12,.2); color:var(--cat-foundation);">Foundation</span>
          <span class="badge" style="background:rgba(2,132,199,.08); border-color:rgba(2,132,199,.2); color:var(--cat-enhancement);">Enhancement</span>
          <span class="badge" style="background:rgba(22,163,74,.08); border-color:rgba(22,163,74,.2); color:var(--cat-retouch);">Retouch</span>
          <span class="badge" style="background:rgba(124,58,237,.08); border-color:rgba(124,58,237,.2); color:var(--cat-advanced);">Advanced</span>
        </div>
        <div class="ds-demo-row" style="margin-top:1rem;">
          <span class="badge" style="background:var(--color-success-bg); border-color:rgba(22,163,74,.2); color:var(--color-success);">✓ Delivered</span>
          <span class="badge" style="background:var(--color-error-bg); border-color:rgba(220,38,38,.2); color:var(--color-error);">✗ Failed</span>
        </div>
      </section>

      <!-- ── INPUTS ───────────────────────────────────────────── -->
      <section id="inputs" class="ds-section">
        <h2 class="ds-section__title">Inputs</h2>
        <div style="max-width:480px; display:flex; flex-direction:column; gap:0.75rem;">
          <input class="input" type="text"  placeholder="Your name" />
          <input class="input" type="email" placeholder="hello@brand.com" />
          <textarea class="input" rows="3"  placeholder="Tell us about your project…" style="resize:vertical;"></textarea>
          <input class="input" type="text" value="Focused state" style="border-color:var(--brand); box-shadow:0 0 0 3px rgba(124,58,237,0.12);" />
        </div>
      </section>

      <!-- ── ANIMATIONS ───────────────────────────────────────── -->
      <section id="animations" class="ds-section">
        <h2 class="ds-section__title">Animations</h2>

        <h3 class="ds-group-title">Scroll Reveal (trigger on load here)</h3>
        <div class="anim-demo-grid">
          <div class="reveal is-visible anim-box"><code>.reveal</code><span>Fade up</span></div>
          <div class="reveal-left is-visible anim-box"><code>.reveal-left</code><span>Fade right</span></div>
          <div class="reveal-scale is-visible anim-box"><code>.reveal-scale</code><span>Scale in</span></div>
        </div>

        <h3 class="ds-group-title">Marquee (logo strip)</h3>
        <div class="marquee-demo">
          <div class="marquee-track">
            <span class="marquee-item">Reframe Visuals</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Background Removal</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Color Correction</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Shadow Effects</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Reframe Visuals</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Background Removal</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Color Correction</span>
            <span class="marquee-item">·</span>
            <span class="marquee-item">Shadow Effects</span>
            <span class="marquee-item">·</span>
          </div>
        </div>

        <h3 class="ds-group-title">Shimmer (skeleton loader)</h3>
        <div class="shimmer-demo">
          <div class="shimmer-bar" style="width:60%;"></div>
          <div class="shimmer-bar" style="width:80%;"></div>
          <div class="shimmer-bar" style="width:45%;"></div>
        </div>
      </section>

      <!-- ── GLASS & FX ────────────────────────────────────────── -->
      <section id="glass" class="ds-section">
        <h2 class="ds-section__title">Glass &amp; FX</h2>

        <div class="glass-demo-bg">
          <div class="glass-liquid glass-shadow" style="padding:1.5rem; border-radius:var(--radius-card);">
            <p style="font-family:var(--font-heading); font-weight:600; font-size:var(--text-heading-4); margin-bottom:0.5rem;">Glass Card</p>
            <p style="color:rgba(0,0,0,0.6); font-size:var(--text-body-sm);">.glass-liquid + .glass-shadow</p>
          </div>
          <div class="glass-liquid" style="padding:1.5rem; border-radius:var(--radius-card);">
            <p style="font-family:var(--font-heading); font-weight:600; font-size:var(--text-heading-4); margin-bottom:0.5rem;">Glass Subtle</p>
            <p style="color:rgba(0,0,0,0.6); font-size:var(--text-body-sm);">.glass-liquid only</p>
          </div>
        </div>
      </section>

      <!-- ── TOKEN REFERENCE TABLE ─────────────────────────────── -->
      <section id="token-ref" class="ds-section">
        <h2 class="ds-section__title">Token Quick Reference</h2>
        <div class="token-table-wrapper">
          <table class="token-table">
            <thead>
              <tr><th>Token</th><th>Value</th><th>Usage</th></tr>
            </thead>
            <tbody>
              <tr><td><code>--brand</code></td><td>#7C3AED</td><td>Primary brand purple — CTAs, active states</td></tr>
              <tr><td><code>--onyx</code></td><td>#0A0A0B</td><td>Dark button background</td></tr>
              <tr><td><code>--color-text-primary</code></td><td>#171717</td><td>All main text</td></tr>
              <tr><td><code>--color-text-secondary</code></td><td>#666666</td><td>Supporting copy</td></tr>
