API_BASE=https://reframevisuals.com/api
VITE_API_URL=/api
PUBLIC_SITE_URL=https://your-test-domain.example
PUBLIC_NOINDEX=true

# EmDash CMS (optional; leave unset to use the REST API / bundled content)
# Same Supabase Postgres as the backend, separate schema: run `CREATE SCHEMA IF NOT EXISTS emdash;` first
EMDASH_DATABASE_URL=postgres://USER:PASS@HOST:5432/postgres?options=-c%20search_path%3Demdash
# Admin sign-in sessions (Vercel has no session driver): Upstash Redis or any Redis URL
REDIS_URL=rediss://default:TOKEN@HOST:6379
# Media storage: Supabase Storage S3 endpoint
S3_ENDPOINT=https://PROJECT.supabase.co/storage/v1/s3
S3_BUCKET=media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_PUBLIC_URL=
