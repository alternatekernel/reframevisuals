---
import { ArrowRight } from 'lucide-react';
---
<div class="min-h-screen bg-white flex items-center justify-center px-6">
    
    <div class="text-center space-y-5 max-w-md">
      <p class="text-[14px] font-black uppercase tracking-[0.18em] text-black/30">404</p>
      <h1 class="text-[36px] font-bold tracking-tight text-[var(--color-text-primary)] leading-tight">
        Page not found.
      </h1>
      <p class="text-[16px] text-black/55 leading-relaxed">
        This page doesn&apos;t exist or may have moved.
      </p>
      <a
        href="/"
        class="inline-flex items-center gap-2 rounded-full bg-[var(--color-text-primary)] px-6 py-3 text-[15px] font-bold text-white hover:bg-black transition-colors"
      >
        Back to home <ArrowRight size={14} />
      </a>
    </div>
  </div>
