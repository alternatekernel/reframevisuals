---
import { CASE_STUDIES } from '../data/expansionPages';
import { Button } from '../components/ui/button';


import { buttonVariants } from '../components/ui/button';
import { cx } from '../utils/theme';

const pathname = Astro.url.pathname;
  const page = CASE_STUDIES.find((c) => c.path === pathname);

  

  const canonical = `https://reframevisuals.com${page.path}`;
  const breadcrumb = {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://reframevisuals.com/' },
      { '@type': 'ListItem', position: 2, name: 'Case Studies', item: 'https://reframevisuals.com/case-studies' },
      { '@type': 'ListItem', position: 3, name: page.h1, item: canonical },
    ],
  };
---
<div class="min-h-screen bg-white">
      <script type="application/ld+json" set:html={JSON.stringify(breadcrumb)} />

      <section class="max-w-4xl mx-auto px-6 py-20">
        <h1 class="text-4xl font-semibold tracking-tight mb-4">{page.h1}</h1>
        <p class="text-black/70 mb-6">{page.description}</p>
        <div class="grid md:grid-cols-3 gap-4 mb-8">
          <div class="border border-black/[0.18] rounded-xl p-4"><p class="text-xs uppercase text-black/50">Client Type</p><p class="font-semibold">Ecommerce Brand</p></div>
          <div class="border border-black/[0.18] rounded-xl p-4"><p class="text-xs uppercase text-black/50">Primary Goal</p><p class="font-semibold">Scale image production</p></div>
          <div class="border border-black/[0.18] rounded-xl p-4"><p class="text-xs uppercase text-black/50">Outcome</p><p class="font-semibold">{page.outcome}</p></div>
        </div>

        <div class="prose prose-lg text-black/75 mb-12">
          <p>
            This case study explores the execution and workflow behind our partnership for the <strong>{page.h1.replace('Case Study: ', '')}</strong> project. The primary focus was establishing a scalable, high-quality image production pipeline that met strict brand guidelines while accelerating time-to-market.
          </p>
          <h3 class="text-xl font-bold text-black mt-8 mb-4">The Challenge</h3>
          <p>
            Prior to Reframe Visuals, the client struggled with inconsistent retouching standards, slow turnaround times, and a lack of predictable quality control. This resulted in frequent revision loops that delayed critical product launches and increased internal operational overhead.
          </p>
          <h3 class="text-xl font-bold text-black mt-8 mb-4">The Solution & Workflow</h3>
          <p>
            We implemented a dedicated production lane featuring custom quality gates and an SLA-backed delivery window. By standardizing the retouching guidelines and establishing a clear feedback loop, we were able to minimize revisions and ensure consistent visual output across all SKUs.
          </p>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="/free-trial" class={cx(buttonVariants({ variant: "default", size: "compact" }), "font-semibold")}>Start free trial</a>
          <a href="/book-meeting" class={cx(buttonVariants({ variant: "outline", size: "compact" }), "border-black/15 font-semibold")}>Book meeting</a>
          <a href="/case-studies" class={cx(buttonVariants({ variant: "outline", size: "compact" }), "border-black/15 font-semibold")}>Back to case studies</a>
        </div>
      </section>
    </div>
