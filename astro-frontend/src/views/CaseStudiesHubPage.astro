---
import { CASE_STUDIES } from '../data/expansionPages';

const title = 'Ecommerce Photo Editing Case Studies | Reframe Visuals';
  const description = 'Real workflow case studies showing how Reframe Visuals improves turnaround, quality consistency, and production reliability for ecommerce brands.';
  const canonical = 'https://reframevisuals.com/case-studies';

  const caseStudySchema = {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Ecommerce Photo Editing Case Studies',
    description: 'Real workflow case studies showing how Reframe Visuals improves turnaround, quality consistency, and production reliability.',
    url: canonical,
    numberOfItems: CASE_STUDIES.length,
    itemListElement: CASE_STUDIES.map((study, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'Article',
        headline: study.h1,
        description: study.description,
        url: `https://reframevisuals.com${study.path}`,
      },
    })),
  };
---
<div class="min-h-screen bg-white">
      <script type="application/ld+json" set:html={JSON.stringify(caseStudySchema)} />
      <section class="max-w-6xl mx-auto px-6 py-20">
        <h1 class="text-4xl font-semibold tracking-tight mb-4">Case Studies</h1>
        <p class="text-black/70 max-w-3xl mb-10">Evidence-focused case stories from ecommerce image production programs.</p>
        <div class="grid md:grid-cols-2 gap-5">
          {CASE_STUDIES.map((c) => (
            <a href={c.path} class="border border-black/[0.18] rounded-2xl p-5 hover:border-black/20 transition-colors">
              <h2 class="font-semibold text-[20px] mb-2">{c.h1}</h2>
              <p class="text-[16px] text-black/65">{c.description}</p>
              <p class="mt-3 text-[16px] text-black font-semibold">Outcome: {c.outcome}</p>
            </a>
          ))}
        </div>
      </section>
    </div>
