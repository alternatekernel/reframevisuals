---
import { ClientRouter } from 'astro:transitions';
import BaseLayout from './BaseLayout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import CurrencySelectorIsland from '../islands/CurrencySelectorIsland';
import BootLoaderIsland from '../islands/BootLoaderIsland';
import ContinueBrowsing from '../components/ContinueBrowsing.astro';
import ChatIsland from '../islands/ChatIsland';
import CookieBanner from '../components/CookieBanner.astro';
export interface Props { title: string; description: string; canonical?: string; ogImage?: string; jsonLd?: object | object[]; noindexOverride?: boolean; hideFooter?: boolean; hideCurrency?: boolean }
const { hideFooter = false, hideCurrency = false, ...seo } = Astro.props;
const currentPath = Astro.url.pathname;
const NO_CONTINUE = ['/', '/order', '/login', '/signup', '/forgot-password', '/reset-password', '/free-trial', '/start', '/pilot-batch', '/contact', '/order/new', '/about', '/about-reframe-visuals'];
---
<BaseLayout {...seo}>
  <ClientRouter slot="head" />
  <div class="min-h-screen flex flex-col bg-[var(--surface)] text-black overflow-x-hidden min-w-0 antialiased" style="isolation: isolate">
    <Navigation />
    <main class="pt-16 flex-grow flex flex-col min-w-0"><slot />{!NO_CONTINUE.includes(currentPath) && <ContinueBrowsing />}</main>
    {!hideFooter && <Footer />}
    {import.meta.env.PUBLIC_BOOT_LOADER === 'true' && <BootLoaderIsland client:load path={currentPath} />}
    <ChatIsland client:interaction transition:persist path={currentPath} />
    <CookieBanner />
    {!hideCurrency && currentPath === '/pricing' && <CurrencySelectorIsland client:idle path={currentPath} />}
  </div>
</BaseLayout>
