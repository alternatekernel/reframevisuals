---
import type { WorkflowNode } from '../../sections/workflow/workflowData';
export interface Props { node: WorkflowNode; delay: number; mobile?: boolean }
const { node, delay, mobile = false } = Astro.props;
const [Icon] = node.icons;
const ticks = ['-top-[5px] -left-[5px]', '-top-[5px] -right-[5px]', '-bottom-[5px] -left-[5px]', '-bottom-[5px] -right-[5px]'];
---
{mobile ? (
  <div class="wf-anim relative w-16 h-16 flex items-center justify-center" style={`--wf-from: scale(0.95); --wf-d:${delay}s; --wf-dur:0.45s; background-color:${node.bg}; border:1.5px dashed ${node.color}`}>
    {ticks.map((t) => <div class={`absolute ${t} w-[10px] h-[10px]`} style={`border: 2px solid ${node.color}`}></div>)}
    <Icon size={24} style={{ color: node.iconColor }} strokeWidth={1.3} />
    <div class="absolute left-[calc(100%+12px)] top-1/2 -translate-y-1/2 flex flex-col items-start gap-0.5 text-left max-w-[110px] sm:max-w-none">
      <span class="text-[14px] font-bold tracking-tight leading-tight" style={`color:${node.color}`}>{node.label}</span>
      <span class="text-[12px] font-semibold text-black/60 tracking-wide leading-tight max-w-[110px] sm:max-w-none">{node.sublabel}</span>
    </div>
  </div>
) : (
  <div class="wf-anim flex flex-col items-center gap-3" style={`--wf-from: translateY(15px); --wf-d:${delay}s; --wf-dur:0.45s`}>
    <span class="text-[15px] font-bold tracking-tight leading-none" style={`color:${node.color}`}>{node.label}</span>
    <div class="relative w-[110px] h-[110px] flex items-center justify-center" style={`background-color:${node.bg}; border:1.5px dashed ${node.color}`}>
      {ticks.map((t) => <div class={`absolute ${t} w-[10px] h-[10px]`} style={`border: 2px solid ${node.color}`}></div>)}
      <Icon size={40} style={{ color: node.iconColor }} strokeWidth={1.3} />
    </div>
    <span class="text-[14px] font-semibold text-black/60 tracking-wide">{node.sublabel}</span>
  </div>
)}
