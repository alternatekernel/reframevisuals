---
import { ChevronLeft, ChevronRight, Package, Info } from 'lucide-react';
import { SERVICES } from '../../data/services';
import { cx, tokens } from '../../utils/theme';

const PRIORITY_IDS = ['jewelry-retouch', 'color-change', 'pattern-change', 'ghost-mannequin', 'model-retouch', 'garment-retouch', 'manipulation'];
const INITIAL = 2;
const GAP = 265, CW = 273;
const prioritized = SERVICES.filter((s: any) => PRIORITY_IDS.includes(s.id));
const others = SERVICES.filter((s: any) => !PRIORITY_IDS.includes(s.id) && s.beforeImage);
const cards = [...prioritized, ...others].slice(0, 10) as any[];
const total = cards.length;
const wrap = (diff: number) => ((((diff + total / 2) % total) + total) % total) - total / 2;

const CARD_WIDTHS = [420, 640];
const opt = (url: string, w: number) => (url.includes('upload/') ? url.replace(/upload\/[^/]+\//, `upload/f_auto,q_auto,c_scale,w_${w}/`) : url);
const srcSet = (url: string) => (url.includes('upload/') ? CARD_WIDTHS.map((w) => `${opt(url, w)} ${w}w`).join(', ') : undefined);
const SIZES = '(min-width: 640px) 273px, 160px';
---
<div data-hc class="flex flex-col items-center w-full pt-0 pb-0 overflow-visible select-none relative" style={`--hc-w:${CW}px`}>
  <div class="relative flex h-[clamp(184px,30svh,230px)] w-full items-center justify-center sm:h-[clamp(300px,42svh,360px)] lg:h-[clamp(330px,44svh,440px)] sm:short:h-[clamp(280px,42svh,340px)]">
    <div class="pointer-events-none absolute bottom-[3%] left-1/2 h-[18%] w-[74%] -translate-x-1/2 rounded-[50%] bg-black/[0.11] opacity-60 blur-[34px]"></div>
    <div class="pointer-events-none absolute bottom-[9%] left-1/2 h-px w-[58%] -translate-x-1/2 bg-gradient-to-r from-transparent via-black/[0.10] to-transparent"></div>

    <div class="absolute inset-x-0 z-[150] flex justify-between px-1 pointer-events-none sm:px-4 lg:px-12">
      <button type="button" data-hc-prev aria-label="Previous" class={cx('group pointer-events-auto flex min-h-11 min-w-11 items-center justify-center rounded-full bg-[var(--color-bg-secondary)]/95 p-2 backdrop-blur-md touch-manipulation sm:min-h-0 sm:min-w-0 sm:p-4', tokens.borderLight, tokens.motionLift)}>
        <ChevronLeft size={20} className="text-black/50 transition-colors group-hover:text-black/80 sm:h-6 sm:w-6" />
      </button>
      <button type="button" data-hc-next aria-label="Next" class={cx('group pointer-events-auto flex min-h-11 min-w-11 items-center justify-center rounded-full bg-[var(--color-bg-secondary)]/95 p-2 backdrop-blur-md touch-manipulation sm:min-h-0 sm:min-w-0 sm:p-4', tokens.borderLight, tokens.motionLift)}>
        <ChevronRight size={20} className="text-black/50 transition-colors group-hover:text-black/80 sm:h-6 sm:w-6" />
      </button>
    </div>

    <div data-hc-stage class="relative w-full h-full flex items-center justify-center z-[100]">
      {cards.map((card, idx) => {
        const o = wrap(idx - INITIAL);
        const active = Math.abs(o) < 0.02;
        const first = card.examples?.[0] || { before: card.beforeImage, after: card.afterImage };
        const variants = card.examples && card.examples.length > 1 ? card.examples.map((e: any) => ({ before: e.before, after: e.after })) : undefined;
        const eager = Math.abs(idx - INITIAL) <= 1;
        const priority = idx === INITIAL;
        const loading = priority || eager || active ? 'eager' : 'lazy';
        const Icon = card.icon;
        const tri = Math.max(0, 1 - Math.abs(o) / 0.5);
        return (
          <div
            data-hc-card
            data-active={String(active)}
            data-revealed="false"
            data-variants={variants ? JSON.stringify(variants) : undefined}
            style={`position:absolute; left:50%; margin-left:${-(CW + 23) / 2}px; transform: translate3d(${o * GAP}px, ${Math.abs(o) * 15}px, 0) rotate(${o * 4}deg); z-index:${Math.round(100 - Math.abs(o) * 10)}; --hc-icon:${tri}`}
            class="flex flex-col items-center pointer-events-none group will-change-transform transform-gpu"
          >
            <div class="relative pointer-events-auto">
              <div class={cx(
                'relative overflow-hidden p-[4px] transition-[transform,box-shadow,border-color] duration-300 transform group-hover:-translate-y-1',
                tokens.heroCarouselCardSurface,
                'before:pointer-events-none before:absolute before:inset-[1px] before:z-30 before:ring-1 before:ring-inset before:ring-black/[0.025]',
                'border-black/[0.14] shadow-[0_18px_44px_-36px_rgba(0,0,0,0.42)] group-data-[active=true]:border-black/[0.20] group-data-[active=true]:shadow-[0_20px_50px_-34px_rgba(0,0,0,0.48)]',
                'hover:border-black/[0.24] hover:shadow-[0_2px_2px_rgba(0,0,0,0.10),0_12px_24px_rgba(0,0,0,0.12),0_34px_68px_rgba(0,0,0,0.17)]'
              )}>
                <div class="flex flex-col">
                  <div class={cx('relative flex items-center justify-center overflow-hidden', tokens.heroCarouselCardMedia)} style="width: var(--hc-w); aspect-ratio: 4/5">
                    {first.after ? (
                      <div data-hc-fade class="w-full h-full" style="transition: opacity 1.2s">
                        <div class="relative overflow-hidden bg-gray-50/50 aspect-[4/5] w-full h-full">
                          <img data-hc-after-img src={opt(first.after, 420)} srcset={srcSet(first.after)} sizes={SIZES} class="absolute inset-0 w-full h-full object-cover" alt="Ecommerce product photo after professional editing by Reframe Visuals" loading={loading} fetchpriority={priority ? 'high' : undefined} decoding="async" draggable="false" />
                          <div data-hc-before class="absolute inset-0 z-10">
                            <img data-hc-before-img src={opt(first.before, 420)} srcset={srcSet(first.before)} sizes={SIZES} class="absolute inset-0 w-full h-full object-cover" alt="Ecommerce product photo before editing - Reframe Visuals" loading={loading} fetchpriority={priority ? 'high' : undefined} decoding="async" draggable="false" />
                          </div>
                          <div data-hc-divider class="absolute inset-y-0 z-20 w-[1px] bg-white/40 pointer-events-none"></div>
                        </div>
                      </div>
                    ) : (
                      <div class="flex flex-col items-center gap-4 text-black/10 select-none pointer-events-none">
                        {Icon && <Icon size={64} strokeWidth={1} />}
                        <p class="font-heading text-[12px] uppercase tracking-widest font-normal opacity-40">Blueprint Mode</p>
                      </div>
                    )}
                  </div>
                  <div class={cx('relative z-20 mt-1 flex items-center justify-between px-3 pb-2 pt-2', tokens.heroCarouselCardFooter)}>
                    <div class="relative group/tooltip">
                      <a href="/dashboard?view=new-project" aria-label="Order now" class="block p-2 -m-2 cursor-pointer text-black/40 hover:text-black transition-colors duration-300" style="opacity: var(--hc-icon, 0)"><Package size={14} /></a>
                      <div class={cx('absolute bottom-full left-0 z-50 mb-2 whitespace-nowrap rounded-md bg-[var(--color-text-primary)] px-3 py-1.5 text-[12px] font-medium text-white opacity-0 transition-opacity pointer-events-none group-hover/tooltip:opacity-100', tokens.shadowStandard)}>Order Now</div>
                    </div>
                    <a href={`/services/${card.id}`} class="flex-1 text-center py-2 cursor-pointer">
                      <p class="font-heading font-normal text-[16px] sm:short:text-[13.5px] tracking-tight text-black/70 group-hover:text-black transition-colors leading-none whitespace-nowrap">{card.name}</p>
                    </a>
                    <div class="relative group/tooltip">
                      <a href={`/services/${card.id}`} aria-label={`${card.name} details`} class="block p-2 -m-2 cursor-pointer text-black/40 hover:text-black transition-colors duration-300" style="opacity: var(--hc-icon, 0)"><Info size={14} /></a>
                      <div class={cx('absolute bottom-full right-0 z-50 mb-2 w-64 rounded-xl border border-white/10 bg-[var(--color-text-primary)] px-4 py-3 text-[14px] font-normal text-white opacity-0 transition-opacity pointer-events-none group-hover/tooltip:opacity-100', tokens.shadowStandard)}><p class="leading-relaxed">{card.description || 'Professional service details.'}</p></div>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
