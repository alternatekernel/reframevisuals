---
import { cx, layout, typography } from '../../utils/theme';
---
<section data-section="hero" class="px-5 sm:px-6 lg:px-12 pt-8 sm:pt-10 pb-8 sm:pb-12 bg-white relative overflow-hidden border-b border-[#f5f5f5]">
      {/* Background Watermark */}
      <div class="absolute top-1/2 left-0 -translate-y-1/2 opacity-[0.02] pointer-events-none">
        <img src="/logo.svg" alt="Reframe Blog Background Graphic" class="w-[260px] h-[260px] sm:w-[420px] sm:h-[420px] -translate-x-1/2" />
      </div>

      <div class={cx(layout.compactShell, "relative z-10")}>
        <div class="text-center max-w-4xl mx-auto" data-reveal>
          <h1 class={cx(typography.vercelSection, "text-[#171717] mb-8")}>
            Decoding the future <br />
            <span class="text-black/40">of visual output.</span>
          </h1>
          <p class="text-[15px] sm:text-[18px] text-[#4d4d4d] leading-relaxed max-w-2xl mx-auto font-normal px-2 sm:px-0">
            Deep dives into neural processing, color science, and the 
            intersection of human artistry with machine throughput.
          </p>
        </div>
      </div>
    </section>
