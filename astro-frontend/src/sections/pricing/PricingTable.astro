---
import { FileText, List, Hash, ArrowRight } from 'lucide-react';
import { cx, layout, tokens, typography } from '../../utils/theme';
import { loadServices, isExcludedService } from '../../lib/serviceData';
import { sortServicesByDisplayOrder } from '../../data/services';
import { publicPillInputClass, publicRoundedInputClass, publicInlineSubmitButtonClass } from '../../components/ui/form-controls';
import Price from '../../components/astro/Price.astro';

const pastelHover = ['hover:bg-red-50/10', 'hover:bg-orange-50/10', 'hover:bg-emerald-50/10', 'hover:bg-blue-50/10', 'hover:bg-purple-50/10'];
const orderedServices = sortServicesByDisplayOrder((await loadServices()).filter((s: any) => !isExcludedService(s)));
const getSimplePrice = (service: any) => {
  const simple = service.tiers?.find((t: any) => t.complexity === 'S' || t.complexity === 'Single' || t.complexity === 'Basic');
  if (simple?.prices?.['24h']) return simple.prices['24h'];
  return service.startingPrice || service.price || 0;
};
const first = orderedServices[0];
const pills = [['12h', 'Express'], ['24h', 'Standard'], ['48h', 'Relaxed'], ['72h', 'Economy']];
const watermarks = [
  'top-[5%] right-[3%] opacity-[0.06]|w-[300px] h-[300px] rotate-10|1',
  'top-[40%] left-[2%] opacity-[0.05]|w-[200px] h-[200px] -rotate-6|2',
  'top-[70%] right-[4%] opacity-[0.05]|w-[250px] h-[250px] rotate-8|3',
  'bottom-[5%] left-[5%] opacity-[0.06]|w-[280px] h-[280px] -rotate-12|4',
].map((s) => s.split('|'));
---
<section class="px-6 lg:px-12 py-16 bg-white border-b border-[#f5f5f5] relative overflow-hidden">
  {watermarks.map(([pos, size, n]) => (
    <div class={cx('absolute pointer-events-none', pos)}><img src="/logo.svg" alt={`Reframe Pricing Graphic ${n}`} class={size} /></div>
  ))}
  <div class={cx(layout.compactShell, 'relative z-10')}>
    <div data-reveal class="text-center max-w-2xl mx-auto mb-12">
      <h2 class={cx(typography.vercelSection, typography.sectionTitleInk, 'mb-8')}>Transparent Pricing.<br /><span class="text-black/40">No surprises.</span></h2>
      <p class="text-[18px] text-[#4d4d4d] leading-relaxed max-w-2xl mx-auto font-normal">Simple, transparent pricing for every service. Prices shown are for 24-hour Standard turnaround with Simple complexity.</p>
    </div>
    <div class="max-w-5xl mx-auto" data-pricing-table>
      <div class="flex flex-wrap items-center justify-center gap-2 mb-8">
        {pills.map(([time, label]) => (
          <div class={cx('inline-flex items-center gap-2 rounded-full border px-4 py-2', label === 'Standard' ? 'border-[var(--color-text-primary)] bg-[var(--color-text-primary)] text-white' : 'border-black/[0.18] bg-white text-[var(--color-text-primary)]')}>
            <span class="text-[14px] font-bold">{time}</span>
            <span class={cx('text-[12px] font-medium', label === 'Standard' ? 'text-white/65' : 'text-black/45')}>{label}</span>
          </div>
        ))}
      </div>
      <div class={cx('relative w-full overflow-hidden', tokens.surfacePanel)}>
        <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-[linear-gradient(90deg,transparent,rgba(23,23,23,0.18),transparent)]"></div>
        <div class="w-full">
          <div class="w-full text-left border-collapse">
            <div class="grid grid-cols-[1fr_120px] sm:grid-cols-[25%_50%_25%] w-full items-stretch bg-[var(--color-bg-secondary)] border-b border-neutral-300/80 text-[12px] font-heading font-semibold text-neutral-600 uppercase tracking-[0.18em] select-none h-11">
              <div class="flex items-center gap-1.5 border-r border-neutral-300/60 px-6"><FileText size={13} className="text-neutral-400 shrink-0" /><span>Service</span></div>
              <div class="hidden sm:flex items-center gap-1.5 border-r border-neutral-300/60 px-6"><List size={13} className="text-neutral-400 shrink-0" /><span>Description</span></div>
              <div class="flex items-center pl-4 pr-6">
                <div class="flex-1 flex items-center justify-center gap-1.5"><Hash size={13} className="text-neutral-400 shrink-0" /><span class="whitespace-nowrap">Starting price</span></div>
                <div class="hidden sm:block w-10 ml-3 shrink-0"></div>
              </div>
            </div>
            <div class="w-full">
              {orderedServices.map((service: any, index: number) => {
                const Icon = service.icon;
                return (
                  <div
                    data-service-id={service.id}
                    data-service-name={service.name}
                    data-selected={String(service === first)}
                    class={cx('group border-b border-neutral-200/80 last:border-b-0 grid grid-cols-[1fr_120px] sm:grid-cols-[25%_50%_25%] w-full items-stretch transition-all duration-200 cursor-pointer text-[14px]', pastelHover[index % pastelHover.length], 'data-[selected=true]:bg-black/[0.05] sm:data-[selected=true]:bg-black/[0.04] data-[selected=false]:hover:bg-black/[0.04]')}
                  >
                    <div class="py-5 px-6 border-r border-neutral-200/70 flex items-center gap-3 min-w-0">
                      <div class="flex h-5 w-5 shrink-0 items-center justify-center text-neutral-400 group-hover:text-neutral-800 group-hover:scale-105 transition-all duration-200">
                        {Icon && <Icon size={16} className="shrink-0" />}
                      </div>
                      <div class="flex flex-col min-w-0">
                        <span class="font-heading text-[15px] font-semibold text-neutral-900 group-hover:text-black transition-colors leading-tight">{service.name}</span>
                        <div class="sm:hidden mt-1 text-[12px] text-neutral-500 leading-normal">{service.description || 'Professional image editing service'}</div>
                      </div>
                    </div>
                    <div class="py-5 px-6 border-r border-neutral-200/70 hidden sm:flex items-center min-w-0">
                      <span class="text-neutral-700 font-sans text-[14px] leading-relaxed">{service.description || 'Professional image editing service'}</span>
                    </div>
                    <div class="py-5 pl-4 pr-6 flex items-center min-w-0">
                      <div class="flex-1 flex items-center justify-center">
                        <Price usd={getSimplePrice(service)} class="font-heading text-[16px] font-semibold text-neutral-900 tabular-nums tracking-tight whitespace-nowrap" />
                      </div>
                      <a href={`/order?serviceId=${service.id}`} aria-label={`Order ${service.name}`} class="hidden sm:inline-flex items-center justify-center min-w-10 h-10 ml-3 rounded-full bg-neutral-50 border border-neutral-300 text-neutral-500 group-hover:bg-neutral-900 group-hover:border-neutral-900 group-hover:text-white transition-all duration-200 shrink-0 sm:opacity-70 sm:group-hover:opacity-100">
                        <ArrowRight size={14} className="transition-transform duration-300 group-hover:-rotate-45" />
                      </a>
                    </div>
                  </div>
                );
              })}
            </div>
          </div>
        </div>
        <div class="px-6 py-10 bg-[var(--color-bg-secondary)] border-t border-neutral-300/80">
          <div class="text-center mb-8">
            <p class="text-[16px] text-[var(--color-text-primary)] font-semibold mb-3">Need detailed pricing for your specific images?</p>
            <p class="text-[15px] text-[var(--color-text-secondary)] max-w-md mx-auto leading-relaxed">Send us your email and sample images. We'll review and send you a personalized quote within ~30 minutes.</p>
          </div>
          <div>
            <div data-local-success class="hidden max-w-md mx-auto p-5 bg-green-50 border border-green-200 rounded-xl text-center">
              <p class="text-green-700 text-[14px] font-medium">Thanks! We'll be in touch soon with your custom quote.</p>
            </div>
            <form data-local-form class="flex flex-col sm:flex-row gap-3 max-w-md mx-auto">
              <input type="email" required placeholder="Enter your work email" class={cx(publicRoundedInputClass, 'flex-1 border-black/15 focus:border-black/40')} />
              <button type="submit" class={cx(publicInlineSubmitButtonClass, 'rounded-xl px-8 font-semibold shadow-md')}>Order now</button>
            </form>
          </div>
          <p class="text-center text-[14px] text-black/40 mt-4">We'll analyze your images and provide accurate pricing tailored to your needs.</p>
        </div>
      </div>
    </div>
  </div>
  {first && (
    <div class="sm:hidden fixed left-1/2 -translate-x-1/2 bottom-[88px] z-[220] w-[calc(100%-24px)] max-w-md">
      <a data-pricing-order href={`/order?serviceId=${first.id}`} class="flex items-center justify-center w-full h-12 rounded-full bg-[var(--color-text-primary)] text-white text-[12px] font-semibold tracking-wide shadow-[0_8px_24px_rgba(0,0,0,0.2)]">Order now: <span data-pricing-order-name class="ml-1">{first.name}</span></a>
    </div>
  )}
</section>
<script>
  import '../../lib/ui/pricing-table';
</script>
