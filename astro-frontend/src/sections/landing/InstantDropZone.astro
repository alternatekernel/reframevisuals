---
import { Upload, X, Plus, Clock, CreditCard, ShieldCheck, AlertTriangle, ArrowRight, Check } from 'lucide-react';

const TRUST_ITEMS = [{ icon: Clock, label: '24h turnaround' }, { icon: CreditCard, label: 'No credit card' }, { icon: ShieldCheck, label: 'Files kept private' }];
const field = 'border border-black/[0.18] bg-white px-5 py-3 text-[15px] font-medium outline-none transition-colors focus-visible:ring-2 focus-visible:ring-black/30 focus:border-black/30';
---
<section data-dropzone class="relative z-10 mx-auto max-w-5xl px-5 sm:px-6 lg:px-10 pt-8 pb-4 lg:pt-12 lg:pb-6">
  <div class="rounded-[24px] border border-black/[0.18] bg-white p-5 shadow-[0_14px_40px_rgba(0,0,0,0.10)] sm:p-8">
    <div data-dz-success class="hidden flex-col items-center py-10 text-center [&:not(.hidden)]:flex">
      <div class="mb-5 flex h-14 w-14 items-center justify-center rounded-full border border-green-100 bg-green-50"><Check size={22} className="text-green-600" /></div>
      <h2 class="text-[26px] sm:text-[30px] font-bold tracking-tight text-[var(--color-text-primary)]">Trial submitted.</h2>
      <p class="mt-2 max-w-md text-[15px] leading-relaxed text-black/60">Your <span data-dz-count>image is</span> in our queue — edited files back within <strong>24 hours</strong>. Track progress from your dashboard.</p>
      <div class="mt-6 flex flex-col gap-2 sm:flex-row">
        <a href="/dashboard" class="inline-flex min-h-11 items-center justify-center gap-2 rounded-full bg-[var(--color-text-primary)] px-6 text-[14px] font-bold text-white transition-all duration-300 hover:bg-black active:scale-95">Go to Dashboard <ArrowRight size={14} /></a>
      </div>
    </div>

    <div data-dz-view>
      <div class="mb-5 text-center sm:mb-6">
        <p class="text-[12px] font-bold uppercase tracking-[0.2em] text-black/40">Instant Free Trial</p>
        <h2 class="mt-2 text-[26px] sm:text-[34px] font-bold tracking-tight leading-[1.1] text-[var(--color-text-primary)]">Drop your product photos. Get 3 edited free.</h2>
        <p class="mx-auto mt-2 max-w-xl text-[14px] sm:text-[15px] leading-relaxed text-black/55">No forms, no calls. Drag your images in and our lead editors send them back polished within 24 hours.</p>
      </div>

      <div data-dz-area data-dz-on="border-[var(--brand)] bg-orange-50/40 scale-[0.995]" data-dz-off="border-black/15 bg-black/[0.04]" data-dz-idle="cursor-pointer hover:border-black/40" role="button" tabindex="0" aria-label="Upload up to 3 product images" class="relative rounded-2xl border-2 border-dashed transition-all duration-200 outline-none focus-visible:ring-2 focus-visible:ring-black/30 border-black/15 bg-black/[0.04] cursor-pointer hover:border-black/40 hover:bg-black/[0.04]">
        <div data-dz-empty class="flex flex-col items-center justify-center gap-3 px-6 py-10 sm:py-14 text-center">
          <div data-dz-icon data-dz-on="bg-black text-white" data-dz-off="bg-black/[0.04] text-black/60" class="flex h-12 w-12 items-center justify-center rounded-full transition-colors bg-black/[0.04] text-black/60"><Upload size={20} /></div>
          <div>
            <p data-dz-drag-text class="text-[15px] sm:text-[17px] font-bold text-[var(--color-text-primary)]">Drag up to 3 images here</p>
            <p class="mt-1 text-[12px] text-black/50">or <span class="font-semibold text-black underline underline-offset-4">browse your files</span> · JPG, PNG, WEBP · up to 15MB each</p>
          </div>
        </div>
        <div data-dz-files class="hidden p-3 sm:p-4">
          <div data-dz-grid class="grid grid-cols-2 gap-3 sm:grid-cols-4">
            <button type="button" data-dz-add class="hidden flex aspect-square flex-col items-center justify-center gap-1.5 rounded-xl border border-dashed border-black/20 text-black/50 transition-all hover:border-black hover:bg-black/[0.04] hover:text-black [&:not(.hidden)]:flex">
              <Plus size={18} />
              <span class="text-[12px] font-semibold">Add more</span>
              <span data-dz-left class="text-[12px] text-black/40">3 slots left</span>
            </button>
          </div>
        </div>
        <input data-dz-input type="file" multiple accept="image/*" class="hidden" />
      </div>
      <template data-dz-thumb>
        <div class="group relative aspect-square overflow-hidden rounded-xl border border-black/[0.18] bg-black/[0.04]">
          <img src="" alt="" class="h-full w-full object-cover" />
          <button type="button" data-dz-remove class="absolute right-2 top-2 rounded-full border border-black/[0.18] bg-white p-1.5 text-black shadow-sm transition-all hover:bg-black hover:text-white"><X size={11} /></button>
          <div class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/70 to-transparent px-2 pb-1.5 pt-5"><p data-dz-meta class="truncate text-[12px] font-medium text-white"></p></div>
        </div>
      </template>

      <div data-dz-notice class="hidden mt-3 rounded-xl border border-amber-200 bg-amber-50 p-3 text-[12px] text-amber-800">
        <div class="flex items-start gap-2 font-semibold"><AlertTriangle size={14} className="mt-0.5 shrink-0" /><span data-dz-notice-text></span></div>
        <p data-dz-notice-list class="mt-1 text-[12px]"></p>
      </div>

      <form data-dz-form novalidate class="hidden mt-4 rounded-2xl border border-black/[0.18] bg-[var(--color-bg-secondary)] p-4 sm:p-5">
        <p class="mb-3 text-[14px] font-bold text-[var(--color-text-primary)]">Last step — where do we send your edited images?</p>
        <div class="flex flex-col gap-3 sm:flex-row">
          <input data-dz-name type="text" placeholder="Your name" aria-label="Full name" required class={`flex-1 rounded-full ${field}`} />
          <input data-dz-email type="email" placeholder="Work email" aria-label="Work email" required class={`flex-1 rounded-full ${field}`} />
          <button data-dz-submit type="submit" disabled class="inline-flex min-h-12 items-center justify-center gap-2 rounded-full bg-[var(--color-text-primary)] px-6 text-[14px] font-bold text-white shadow-sm transition-all duration-300 hover:bg-black active:scale-95 disabled:opacity-60">
            <span data-dz-submit-label>Get my free edits</span>
            <span data-dz-submit-arrow class="inline-flex"><ArrowRight size={15} /></span>
          </button>
        </div>
        <div class="mt-3 flex flex-col gap-3">
          <textarea data-dz-instructions placeholder="Editing instructions — background, shadows, colour, anything specific (optional)" aria-label="Editing instructions" rows="3" maxlength="4000" class={`w-full resize-y rounded-2xl ${field}`}></textarea>
          <input data-dz-link type="url" placeholder="Drive / Dropbox / WeTransfer link to more files (optional)" aria-label="Link to additional files" class={`w-full rounded-full ${field}`} />
        </div>
        <div data-dz-progress class="hidden mt-3 rounded-xl border border-blue-100 bg-blue-50 p-3 text-[14px] font-semibold text-blue-700">Uploading your images...</div>
        <div data-dz-error class="hidden mt-3 rounded-xl border border-red-100 bg-red-50 p-3 text-[14px] font-semibold text-red-600"></div>
      </form>

      <div class="mt-4 flex flex-col items-center justify-center gap-2 sm:flex-row sm:gap-6">
        <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-1.5">
          {TRUST_ITEMS.map(({ icon: Icon, label }) => (
            <div class="flex items-center gap-1.5 text-black/55"><Icon size={13} className="text-black/60" /><span class="text-[11.5px] font-semibold">{label}</span></div>
          ))}
        </div>
        <a href="/free-trial" class="text-[11.5px] font-semibold text-black/45 underline underline-offset-4 transition-colors hover:text-black">Prefer to add project details? Use the full brief form</a>
      </div>
    </div>
  </div>
</section>
<script>
  import '../../lib/ui/drop-zone';
</script>
