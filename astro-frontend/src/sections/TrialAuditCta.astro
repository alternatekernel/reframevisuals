---
import { ArrowRight } from 'lucide-react';
import { publicRoundedInputClass } from '../components/ui/form-controls';
import { cx } from '../utils/theme';
---
<section class="w-full max-w-3xl mx-auto px-6 text-center pt-4 pb-10 lg:pt-5 lg:pb-12 overflow-visible">
  <div class="flex flex-col items-center">
    <div data-reveal data-reveal-variant="rise-scale" data-reveal-threshold="0.15" style="--reveal-duration:0.7s;--reveal-y:30px" class="relative w-full space-y-4 overflow-hidden rounded-[28px] border border-[#BAE6FD]/80 animate-card-bg p-5 shadow-[0_18px_48px_rgba(15,23,42,0.14)] sm:p-7">
      <div class="pointer-events-none absolute -top-10 -right-10 h-36 w-36 rounded-full bg-white/55 blur-2xl"></div>
      <div class="pointer-events-none absolute -bottom-12 -left-8 h-36 w-36 rounded-full bg-[#BFDBFE]/35 blur-2xl"></div>
      <h3 class="relative z-10 text-[22px] font-semibold leading-[1.15] tracking-tight text-[var(--color-text-primary)] lg:text-[28px]">See the edit quality before you pay.</h3>
      <p class="relative z-10 mx-auto max-w-xl text-[15px] font-medium leading-relaxed text-black/70">Submit your images. We'll edit them and send back the before/after.</p>
      <form action="/free-trial" method="get" class="relative z-10 mt-6 mx-auto grid w-full max-w-xl grid-cols-1 gap-2.5 sm:grid-cols-[1fr_auto] sm:items-stretch">
        <input type="email" name="email" placeholder="Enter your work email" required class={cx(publicRoundedInputClass, 'bg-white/95')} />
        <button type="submit" class="group inline-flex min-h-12 touch-manipulation items-center justify-center gap-2 whitespace-nowrap rounded-full bg-[var(--color-text-primary)] py-1.5 pl-6 pr-1.5 text-[15px] font-bold text-white shadow-[0_8px_24px_rgba(0,0,0,0.10)] transition-all hover:bg-black active:scale-95 sm:min-h-full">
          <span>Get 3 Free Sample Edits</span>
          <span class="inline-flex h-8 w-8 items-center justify-center rounded-full bg-white/90 text-black"><ArrowRight size={14} className="transition-transform duration-300 group-hover:-rotate-45" /></span>
        </button>
      </form>
      <div class="relative z-10 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-[14px] font-medium text-black/70">
        <span>Replies within 30 min</span><span class="hidden text-black/25 sm:inline">•</span><span>No spam, ever</span><span class="hidden text-black/25 sm:inline">•</span><span>Editor on every image</span>
      </div>
    </div>
  </div>
</section>
