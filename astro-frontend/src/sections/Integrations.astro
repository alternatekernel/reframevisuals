---
import { Bot, Box, Cloud, ExternalLink, Share2, Zap } from 'lucide-react';
import { cx, layout, typography } from '../utils/theme';

const INTEGRATIONS = [
  { name: 'Dropbox', status: 'Live', icon: Share2, color: 'rgba(0,0,0,0.8)' },
  { name: 'WeTransfer', status: 'Live', icon: ExternalLink, color: 'rgba(0,0,0,0.8)' },
  { name: 'OneDrive', status: 'Live', icon: Cloud, color: 'rgba(0,0,0,0.8)' },
  { name: 'Amazon', status: 'Coming Soon', icon: Box, color: 'rgba(0,0,0,0.8)' },
  { name: 'Workflow Sync', status: 'Private Beta', icon: Zap, color: '#FF4A00' },
  { name: 'AI Ready', status: 'Live', icon: Bot, color: 'rgba(0,0,0,0.8)' },
];
---
<section id="integrations" class="relative overflow-hidden bg-surface pt-10 pb-8 sm:pt-12 sm:pb-10 lg:pt-16 lg:pb-12">
      <div class={cx(layout.compactShell, 'relative z-10 px-5 sm:px-6 lg:px-10')}>
        <div class="grid gap-8 lg:grid-cols-[0.78fr_1.22fr] lg:items-center lg:gap-10">
          <div>
            <h2 class={cx(typography.displayLg, "text-text-primary")}>
              Connected <span class="text-black/35">Ecosystem.</span>
            </h2>

            <p class="mt-5 max-w-lg text-[16px] font-medium leading-relaxed text-black/60 lg:text-[17px]">
              Connect Google Drive, Dropbox, automated app workflows, or any AI tool. Files in, edited images out.
            </p>
          </div>

          <div class="rounded-[28px] border border-black/[0.18] bg-white p-3 shadow-[0_18px_60px_-50px_rgba(0,0,0,0.5)]">
            <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-3">
              {INTEGRATIONS.map((item, index) => (
                <article class={cx(
                    'group flex items-center gap-3 rounded-2xl border p-3 transition-all duration-300 hover:-translate-y-0.5 hover:bg-white lg:min-h-[150px] lg:flex-col lg:justify-center lg:text-center',
                    'border-black/[0.18] bg-white hover:border-black/18'
                  )} data-reveal style={{ '--reveal-delay': `${index * 0.06}s`, '--reveal-duration': '0.28s', '--reveal-y': '14px' }}>
                  <div
                    class="flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-black/[0.18] bg-white transition-transform group-hover:scale-105"
                    style={{ color: item.color }}
                  >
                    <item.icon size={20} strokeWidth={1.8} />
                  </div>

                  <div class="min-w-0 w-full">
                    <h3 class="break-words whitespace-normal text-[16px] font-bold leading-tight text-black lg:text-[17px]">{item.name}</h3>
                    <p class={cx('mt-1 text-12 font-black uppercase tracking-[0.1em]', 'text-black/38')}>
                      {item.status}
                    </p>
                  </div>
                </article>
              ))}
            </div>

            <div class="mt-3 rounded-2xl border border-semantic-success-border bg-semantic-success-light/50 px-4 py-3">
              <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:gap-3">
                <span class="whitespace-nowrap text-12 font-black uppercase tracking-[0.15em] text-semantic-success">Live · AI Ready</span>
                <span class="hidden h-3.5 w-px bg-semantic-success-border sm:block" />
                <p class="text-body leading-relaxed text-semantic-success-text/80">
                  Submit orders, track status, and manage revisions from any AI assistant or automation tool.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
