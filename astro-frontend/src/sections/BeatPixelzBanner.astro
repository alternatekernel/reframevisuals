---
import { ArrowRight } from 'lucide-react';
---
<section class="relative overflow-hidden" data-reveal="load" style={{ '--reveal-delay': `${0.15}s`, '--reveal-duration': '0.65s' }}>
      <div class="relative z-10 mx-auto max-w-7xl px-5 py-7 sm:px-8 sm:py-8 lg:px-10 lg:py-9">
        <div class="relative overflow-hidden rounded-[28px] border border-black/[0.16] animate-card-bg px-5 py-6 shadow-[0_24px_60px_-34px_rgba(15,23,42,0.18)] sm:px-6 lg:flex lg:items-center lg:justify-between lg:gap-10 lg:px-8 lg:py-7">
          {/* Decorative blurs */}
          <div class="pointer-events-none absolute -top-10 -right-10 h-36 w-36 rounded-full bg-white/55 blur-2xl" />
          <div class="pointer-events-none absolute -bottom-12 -left-8 h-36 w-36 rounded-full bg-black/[0.05] blur-2xl" />

          {/* Left: Copy */}
          <div class="relative z-10 flex flex-col gap-1.5">
            <h2 class="text-[22px] sm:text-[26px] lg:text-[30px] font-bold leading-[1.2] tracking-[-0.03em] text-[var(--color-text-primary)]">
              Better edges than AI tools. Lower price than enterprise studios.{' '}
              <span class="text-black/35">From $0.39/image.</span>
            </h2>
            <p class="mt-1 max-w-2xl text-[16px] leading-relaxed text-black/55">
              Human QA, cleaner edges, and per-image pricing with no subscription.
            </p>
          </div>

          {/* Right: CTAs */}
          <div class="relative z-10 mt-5 flex shrink-0 flex-col gap-2.5 sm:flex-row lg:mt-0 lg:flex-col lg:items-stretch">
            <a
              href="/free-trial?type=pilot"
              class="group inline-flex min-h-12 items-center justify-center gap-2 whitespace-nowrap rounded-full bg-[var(--color-text-primary)] py-1.5 pl-6 pr-1.5 text-[16px] font-bold text-white shadow-[0_8px_24px_rgba(0,0,0,0.10)] transition-all hover:bg-black active:scale-95"
            >
              <span>Get 3 Free Sample Edits</span>
              <span class="inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-white/90 text-black">
                <ArrowRight size={14} className="transition-transform duration-300 group-hover:-rotate-45" />
              </span>
            </a>
            <a
              href="/pricing"
              class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-full border border-black/[0.18] bg-white px-6 text-[16px] font-bold text-[var(--color-text-primary)] transition-all hover:bg-black/[0.05] active:scale-95"
            >
              See pricing
            </a>
          </div>
        </div>
      </div>
    </section>
