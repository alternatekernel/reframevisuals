---
import { ArrowRight, BookOpen } from 'lucide-react';
import { cx, typography } from '../utils/theme';
import { loadBlogPosts } from '../lib/blogSeed';

const blogPosts = await loadBlogPosts();
const recent = [...blogPosts]
  .sort((a, b) => {
    if (a.featured !== b.featured) return a.featured ? -1 : 1;
    return (Date.parse(b.updatedAt || b.date) || 0) - (Date.parse(a.updatedAt || a.date) || 0);
  })
  .slice(0, 3)
  .map((post) => ({
    category: post.category ? post.category.charAt(0).toUpperCase() + post.category.slice(1) : 'General',
    title: post.title,
    readTime: post.readTime,
    slug: post.slug,
  }));
const featured = recent[0];
const secondary = recent.slice(1);
---
{recent.length > 0 && (
  <section class="relative overflow-hidden bg-[#0b0b10] pt-12 pb-12 sm:pt-14 sm:pb-14 lg:pt-20 lg:pb-20 text-white">
    <div class="pointer-events-none absolute left-1/2 top-[-220px] h-[440px] w-[820px] -translate-x-1/2 rounded-full bg-white/[0.03] blur-3xl"></div>
    <div class="pointer-events-none absolute bottom-[-10%] left-[14%] h-56 w-56 rounded-full bg-white/5 blur-3xl"></div>
    <div class="pointer-events-none absolute right-[10%] top-[18%] h-52 w-52 rounded-full bg-white/5 blur-3xl"></div>
    <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-white/[0.06]"></div>
    <div class="relative z-10 mx-auto max-w-[1240px] px-5 sm:px-6 lg:px-10">
      <div class="mb-8 grid gap-6 lg:mb-10 lg:grid-cols-[0.95fr_auto] lg:items-end">
        <div class="max-w-3xl">
          <div data-reveal style="--reveal-y:10px" class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1.5 text-[12px] font-bold text-white/65">
            <BookOpen size={14} />
            Reframe Blog
          </div>
          <h2 data-reveal style="--reveal-y:16px;--reveal-delay:0.08s" class={cx(typography.displayXl, 'text-white')}>Knowledge from the <span class="text-white/40">editing floor.</span></h2>
          <p data-reveal style="--reveal-y:16px;--reveal-delay:0.14s" class="mt-5 max-w-2xl text-[16px] font-medium leading-relaxed text-white/60 lg:text-[18px]">Retouching technique, marketplace prep, and catalog ops. From editors who do this work.</p>
        </div>
        <a href="/blog" data-reveal data-reveal-variant="slide-right" style="--reveal-delay:0.18s" class="inline-flex min-h-[52px] w-full sm:w-max items-center justify-center rounded-full border border-white/10 bg-white px-6 text-[15px] font-bold text-[var(--color-text-primary)] transition-all hover:bg-white/90 active:scale-95">View all blog posts</a>
      </div>
      <div class="grid gap-4 lg:grid-cols-[1.3fr_0.7fr]">
        <a href={`/blog/${featured.slug}`} data-reveal data-reveal-threshold="0.2" style="--reveal-y:18px" class="group relative flex flex-col justify-between min-h-[320px] cursor-pointer overflow-hidden rounded-[28px] border border-white/10 bg-white/[0.04] p-6 transition-all hover:border-white/18 hover:bg-white/[0.06] sm:p-8 lg:p-10 shadow-[0_24px_60px_-42px_rgba(0,0,0,0.55)]">
          <div class="absolute inset-x-8 top-0 h-px bg-gradient-to-r from-transparent via-white/12 to-transparent"></div>
          <div class="flex flex-grow flex-col justify-between gap-12 sm:gap-16">
            <div>
              <p class="mb-5 text-[12px] font-semibold uppercase tracking-widest text-white/40">{featured.category}</p>
              <h3 class={cx(typography.displayMd, 'max-w-2xl text-white')}>{featured.title}</h3>
            </div>
            <div class="flex items-center justify-between border-t border-white/10 pt-5">
              <span class="text-[14px] font-bold text-white/40">{featured.readTime}</span>
              <span class="flex h-10 w-10 items-center justify-center rounded-full bg-white text-[var(--color-text-primary)] transition-transform group-hover:-rotate-45"><ArrowRight size={16} /></span>
            </div>
          </div>
        </a>
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
          {secondary.map((post, i) => (
            <a href={`/blog/${post.slug}`} data-reveal data-reveal-threshold="0.2" style={`--reveal-y:18px;--reveal-delay:${0.08 + i * 0.06}s`} class="group cursor-pointer rounded-[28px] border border-white/10 bg-white/[0.04] p-5 transition-all hover:-translate-y-0.5 hover:border-white/18 hover:bg-white/[0.06] sm:p-6 shadow-[0_20px_50px_-40px_rgba(0,0,0,0.55)] flex flex-col justify-between">
              <div>
                <p class="mb-4 text-[12px] font-semibold uppercase tracking-widest text-white/35">{post.category}</p>
                <h3 class="line-clamp-3 text-[19px] sm:text-[21px] font-semibold leading-tight tracking-[-0.025em] text-white/90">{post.title}</h3>
              </div>
              <div class="mt-7 flex items-center justify-between border-t border-white/10 pt-4">
                <span class="text-[12px] font-bold text-white/35">{post.readTime}</span>
                <ArrowRight size={16} className="text-white/45 transition-transform duration-300 group-hover:-rotate-45" />
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>
)}
