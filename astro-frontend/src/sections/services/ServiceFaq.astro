---
import { HelpCircle, Plus, Minus, ArrowRight } from 'lucide-react';
import { cx, layout, tokens, typography } from '../../utils/theme';
const DEFAULT_FAQS = [
  { q: 'What file formats do you deliver?', a: 'We deliver in all industry-standard formats including high-res JPG, transparent PNG, layered PSD, and TIFF, optimized for your specific platform.' },
  { q: 'How fast is the turnaround?', a: 'Our standard delivery is within 24 hours. For urgent projects, we offer express delivery within 12 hours depending on volume.' },
  { q: 'Do you offer bulk discounts?', a: 'Yes, for high-volume enterprise projects (500+ images), we offer custom pricing tiers. Contact our sales team for a formal quote.' },
  { q: 'Can I request revisions?', a: 'Absolutely. Customer satisfaction is our priority. We offer unlimited minor revisions until the output perfectly matches your brand guidelines.' },
];
const { service } = Astro.props;
const faqs: any[] = service?.faqs || DEFAULT_FAQS;
---
<section class="py-12 lg:py-20 bg-white">
  <div class={cx(layout.compactShell, 'px-6 lg:px-12')}>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-24">
      <div class="lg:col-span-5 space-y-10">
        <div class="space-y-4">
          <div class="flex items-center gap-3 text-black/40"><HelpCircle size={20} /><span class="text-[12px] font-bold tracking-[0.2em] uppercase">Support</span></div>
          <h2 class={cx('font-heading text-[var(--fluid-h2)] lg:text-[64px] font-bold tracking-[-0.04em] leading-[1.2]', typography.sectionTitleInk)}>Common <br /><span class="text-black/40">Inquiries.</span></h2>
          <p class="text-[18px] lg:text-[20px] text-[var(--color-text-secondary)] leading-relaxed font-normal">Everything you need to know about our production process and delivery standards.</p>
        </div>
        <div class="pt-6">
          <a href="/contact" class="group inline-flex h-[50px] lg:h-[56px] items-center gap-3 rounded-full border border-black/[0.18] bg-white px-8 text-[15px] lg:text-[16px] font-bold text-black transition-colors hover:bg-black/5">
            Contact the team
            <div class="flex h-6 w-6 items-center justify-center rounded-full bg-black/5 transition-transform group-hover:translate-x-1"><ArrowRight size={14} strokeWidth={3} /></div>
          </a>
        </div>
      </div>
      <div class="lg:col-span-7 space-y-3" data-acc-group>
        {faqs.map((faq) => (
          <div data-acc-item data-open="false" class={cx('group/acc overflow-hidden bg-[var(--color-bg-secondary)]/50 rounded-2xl border border-black/[0.12]', tokens.motionInteractive)}>
            <button type="button" data-acc-toggle aria-expanded="false" class="w-full flex items-center justify-between p-7 text-left hover:bg-white transition-colors">
              <span class="text-[20px] lg:text-[22px] font-bold text-[var(--color-text-primary)] tracking-tight">{faq.q}</span>
              <div class="shrink-0 w-8 h-8 rounded-lg bg-black/[0.04] flex items-center justify-center text-black/40">
                <Plus size={18} className="group-data-[open=true]/acc:hidden" />
                <Minus size={18} className="hidden group-data-[open=true]/acc:block" />
              </div>
            </button>
            <div data-acc-panel>
              <div><div class="px-7 pb-8 text-[16px] lg:text-[18px] font-medium text-black/60 leading-relaxed max-w-xl">{faq.a}</div></div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
<script>
  import '../../lib/ui/accordion';
</script>
