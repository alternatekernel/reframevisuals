---
import React from 'react';
import { Button } from '../../components/ui/button';

interface ServicesCTAProps {
  isUserAuthenticated: boolean;
}


import { buttonVariants } from '../../components/ui/button';
import { cx } from '../../utils/theme';

const { isUserAuthenticated } = Astro.props;

---
<section class="px-6 py-24 lg:py-32 bg-white">
      <div class="max-w-5xl mx-auto">
        <div class="relative overflow-hidden rounded-[28px] border border-black/[0.18] bg-[var(--color-bg-secondary)] px-6 py-16 sm:px-10 lg:px-16 lg:py-20 shadow-sm">
          <div class="pointer-events-none absolute -top-20 -right-16 h-56 w-56 rounded-full bg-[var(--color-brand-primary)]/10 blur-3xl" />
          <div class="pointer-events-none absolute -bottom-16 -left-10 h-52 w-52 rounded-full bg-[var(--color-brand-accent)]/10 blur-3xl" />

          <div class="relative text-center">
            <h2 class="text-4xl lg:text-6xl font-heading font-bold tracking-[-0.05em] text-[var(--color-text-primary)] mb-8 leading-tight">
              Send your first <br />
              <span class="text-black/40">batch today.</span>
            </h2>
            <p class="text-[20px] text-black/60 font-normal mb-12 max-w-2xl mx-auto">
              Human editors, transparent pricing, 24-72 hour turnaround.
            </p>

            <div class="flex flex-col items-center gap-6">
              <a href="/free-trial" data-auth-cta class={cx(buttonVariants({ variant: "default" }), "h-12 px-6 font-bold tracking-wide")}>
                  <span data-auth-cta-label>Get 3 Free Sample Edits</span>
                </a>

              <p class="text-[12px] text-black/45 font-medium tracking-wide uppercase">
                <span data-guest-note>No credit card required</span><span data-auth-note class="hidden">3 free edits remaining</span> | Review first, always
              </p>
              <p class="text-[16px] font-medium text-black/65">Need custom scope? Email <a href="mailto:hello@reframevisuals.com" class="underline">hello@reframevisuals.com</a></p>
            </div>
          </div>
        </div>
      </div>
    </section>
