---
import React from 'react';
import { cx, layout } from '../../utils/theme';

interface ServicePrecisionProps {
  service: any;
}

const { service } = Astro.props;


const metrics = service?.precisionMetrics || [
    'Volume discounts starting at 500+ images',
    'Custom SLA and dedicated API access',
    'Dedicated account manager and QA team',
  ];
---
<section class="pt-10 pb-12 sm:pt-12 sm:pb-14 lg:pt-16 lg:pb-20 bg-white overflow-hidden border-b border-[var(--color-border-light)]">
      <div class={cx(layout.compactShell, "px-6 lg:px-12")}>
        <div class="p-10 lg:p-20 bg-[var(--color-text-primary)] rounded-[28px] text-white relative overflow-hidden group border border-white/5 shadow-[0_24px_60px_rgba(15,23,42,0.12)]">
          {/* Subtle radial glow for premium feel */}
          <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_var(--color-border-light)_0%,_transparent_60%)] opacity-20 pointer-events-none" />
          
          <div class="relative z-10 max-w-3xl space-y-12">
            <h2 class="font-heading text-[32px] lg:text-[56px] font-bold tracking-[-0.04em] leading-[1.1] text-white">
              Have a large batch?<br />
              Get a custom quote in minutes.
            </h2>
            
            <ul class="space-y-8">
              {metrics.map((item: string, index: number) => (
                <li class="flex items-center gap-4 text-[16px] lg:text-[18px] text-white/80 font-normal tracking-tight">
                  <div class="w-1.5 h-1.5 rounded-full bg-white/80 shrink-0" />
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>
