---
import { cx, layout, typography } from '../../utils/theme';
import BeforeAfter from '../../components/astro/BeforeAfter.astro';
import ButtonWithIcon from '../../components/astro/ButtonWithIcon.astro';
import Price from '../../components/astro/Price.astro';
export interface Props { service: any; price: number }
const { service, price } = Astro.props;
---
<section data-section="hero" class="relative overflow-hidden bg-white px-6 pt-20 pb-12 lg:px-12 lg:pt-28 lg:pb-16 border-b border-[var(--color-border-light)]">
  <div class="absolute top-1/2 left-0 -translate-y-1/2 opacity-[0.02] pointer-events-none">
    <img src="/logo.svg" alt="Reframe Service Background Graphic" class="w-[300px] h-[300px] sm:w-[500px] sm:h-[500px] -translate-x-1/2" />
  </div>
  <div class={cx(layout.compactShell, 'relative z-10')}>
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-16 items-center">
      <div class="lg:col-span-7 space-y-8 lg:space-y-10">
        <div data-reveal="load" class="space-y-4 lg:space-y-6">
          <div class={cx(typography.vercelMono, 'text-black/45')}>Service Detail</div>
          <h1 class={cx('text-[40px] lg:text-[64px] font-bold leading-[1.05] tracking-[-0.04em]', typography.sectionTitleInk)}>{service.name}</h1>
          <p class="text-[16px] lg:text-[18px] text-[var(--color-text-secondary)] leading-relaxed max-w-xl font-medium">
            {service.detail || service.description || 'Professional retouching with human editors and QA review on every file.'}
          </p>
        </div>
        <div data-reveal="load" style="--reveal-delay:0.15s" class="grid grid-cols-2 overflow-hidden rounded-2xl border border-white/70 bg-white/70 shadow-[0_18px_48px_rgba(15,23,42,0.06)] backdrop-blur-xl lg:grid-cols-4 lg:rounded-3xl">
          <div class="p-4 lg:p-6 space-y-1 lg:space-y-2 border-r border-b lg:border-b-0 border-white/60">
            <span class="block text-[9px] lg:text-[12px] font-bold tracking-widest text-black/40 uppercase">Starting</span>
            <Price usd={price} class="block text-xl lg:text-2xl font-bold text-[var(--color-text-primary)] tracking-tighter" />
          </div>
          <div class="p-4 lg:p-6 space-y-1 lg:space-y-2 border-b lg:border-b-0 lg:border-r border-white/60">
            <span class="block text-[9px] lg:text-[12px] font-bold tracking-widest text-black/40 uppercase">Daily Capacity</span>
            <p class="text-xl lg:text-2xl font-bold text-[var(--color-text-primary)] tracking-tighter">{service.servicePageContent?.dailyCapacity || '10k+'}</p>
          </div>
          <div class="p-4 lg:p-6 space-y-1 lg:space-y-2 border-r border-white/60">
            <span class="block text-[9px] lg:text-[12px] font-bold tracking-[0.2em] text-black/40 uppercase">Precision</span>
            <p class="text-xl lg:text-2xl font-bold tracking-tighter text-[var(--color-text-primary)]">Pixel</p>
          </div>
          <div class="p-4 lg:p-6 space-y-1 lg:space-y-2">
            <span class="block text-[9px] lg:text-[12px] font-bold tracking-widest text-black/40 uppercase">Revisions</span>
            <p class="text-xl lg:text-2xl font-bold text-[var(--color-text-primary)] tracking-tighter">∞</p>
          </div>
        </div>
        <div data-reveal="load" data-reveal-fade style="--reveal-delay:0.3s;--reveal-y:0px" class="flex flex-col sm:flex-row items-center gap-3 lg:gap-4 pt-2">
          <ButtonWithIcon variant="default" label="Order Now" href="/order" class="!w-full sm:!w-auto !h-[50px] lg:!h-[56px] !text-[15px] lg:!text-[16px]" authCta data-auth-label="Start Production" data-auth-href="/order" />
          <a href="/pricing" class="flex h-[50px] lg:h-[56px] items-center justify-center rounded-full border border-black/[0.18] bg-white px-8 text-[15px] lg:text-[16px] font-bold text-[var(--color-text-primary)] transition-all hover:bg-black/5 active:scale-95 w-full sm:w-auto">View Pricing</a>
        </div>
      </div>
      <div class="lg:col-span-5 relative w-full max-w-sm lg:max-w-md mx-auto">
        <div class="absolute -inset-3 lg:-inset-4 bg-white/40 backdrop-blur-3xl rounded-[32px] lg:rounded-[40px] border border-white/60 shadow-[0_20px_40px_rgba(0,0,0,0.09)] lg:shadow-[0_40px_80px_rgba(0,0,0,0.10)] rotate-[-2deg] scale-[0.98] transition-transform duration-700 hover:rotate-0"></div>
        <div data-reveal="load" data-reveal-scale style="--reveal-duration:0.7s;--reveal-y:0px" class="relative aspect-square lg:aspect-[4/5] bg-[var(--color-text-primary)] rounded-[24px] lg:rounded-[32px] border border-black/[0.16] overflow-hidden shadow-[0_24px_60px_rgba(15,23,42,0.16)]">
          {service.beforeImage && service.afterImage ? (
            <BeforeAfter beforeImage={service.beforeImage} afterImage={service.afterImage} aspectRatio="h-full w-full" class="absolute inset-0 w-full h-full rounded-none border-none" active={true} />
          ) : (
            <div class="absolute inset-0 flex items-center justify-center bg-[var(--color-bg-secondary)]">
              <p class="text-xs lg:text-sm font-bold tracking-widest text-black/30 uppercase">Preview Loading...</p>
            </div>
          )}
        </div>
        <div data-reveal="load" style="--reveal-delay:0.6s;--reveal-y:15px" class="absolute -bottom-4 -left-4 lg:-bottom-6 lg:-left-6 bg-white border border-black/[0.18] shadow-xl rounded-xl lg:rounded-2xl p-3 lg:p-4 flex items-center gap-3 lg:gap-4 z-20">
          <div class="w-8 h-8 lg:w-10 lg:h-10 rounded-full bg-brand/10 flex items-center justify-center"><span class="relative inline-flex h-2.5 w-2.5 rounded-full bg-[var(--color-brand-primary)]"></span></div>
          <div>
            <p class="text-[9px] lg:text-[12px] font-bold tracking-widest text-black/40 uppercase">Interactive</p>
            <p class="text-[12px] lg:text-[14px] font-bold text-[var(--color-text-primary)] tracking-tight">Drag to Compare</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
