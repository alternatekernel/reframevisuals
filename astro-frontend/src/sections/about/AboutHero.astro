---
import { cx, layout, typography } from '../../utils/theme';
---
<section data-section="hero" class="relative px-6 lg:px-12 pt-24 pb-16 bg-white overflow-hidden">
      <div class={cx(layout.compactShell, "relative z-10")}>
        <div class="text-center max-w-4xl mx-auto" data-reveal="load">
          <h1 class={cx(typography.vercelSection, "text-[#171717] mb-8")}>
            Product photo editing <br />
            <span class="text-black/40">for ecommerce brands.</span>
          </h1>
          <p class="text-[18px] lg:text-[20px] text-[#4d4d4d] leading-relaxed max-w-2xl mx-auto font-normal">
            Reframe Visuals edits product photos for online brands. Human editors handle each image,
            and a QA reviewer checks every file before it ships.
          </p>
        </div>
      </div>
    </section>
