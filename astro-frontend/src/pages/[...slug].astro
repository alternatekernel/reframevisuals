---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
import { STATIC_ROUTES } from '../data/staticRoutes';
import { SEO_META_BY_PATH, resolvePageSeo } from '../data/seoMeta';
import heads from '../data/collectedHeads.json';
import AboutPage from '../views/AboutPage.astro';
import AboutReframeVisualsPage from '../views/AboutReframeVisualsPage.astro';
import ReframeVisualsServicesPage from '../views/ReframeVisualsServicesPage.astro';
import HowItWorksPage from '../views/HowItWorksPage.astro';
import PlatformPage from '../views/PlatformPage.astro';
import PolicyPage from '../views/PolicyPage.astro';
import CaseStudiesHubPage from '../views/CaseStudiesHubPage.astro';
import ResourcesPage from '../views/ResourcesPage.astro';
import ComparisonPage from '../views/ComparisonPage.astro';
import CaseStudyDetailPage from '../views/CaseStudyDetailPage.astro';
import InsightAndTrustPage from '../views/InsightAndTrustPage.astro';
import ExpansionPage from '../views/ExpansionPage.astro';
import FreeTrialPage from '../views/FreeTrialPage.astro';
import StartPage from '../views/StartPage.astro';
import PilotBatchPage from '../views/PilotBatchPage.astro';
import BookMeetingPage from '../views/BookMeetingPage.astro';
import ContactPage from '../views/ContactPage.astro';
import QuoteBuilderPage from '../views/QuoteBuilderPage.astro';
import ServicesPage from '../views/ServicesPage.astro';
import PricingPage from '../views/PricingPage.astro';
import PortfolioPage from '../views/PortfolioPage.astro';
import TestimonialsPage from '../views/TestimonialsPage.astro';
import AIProductVisualsPage from '../views/AIProductVisualsPage.astro';

export function getStaticPaths() {
  return STATIC_ROUTES.map((r) => ({ params: { slug: r.path.slice(1) }, props: r }));
}
const HIDE_FOOTER = ['/free-trial', '/start', '/pilot-batch', '/book-meeting'];
const FOCUSED = ['/free-trial', '/start', '/pilot-batch', '/contact'];
const { path, view, noindex } = Astro.props;
const mapped = SEO_META_BY_PATH[path];
const own = mapped ? undefined : (heads as Record<string, { title?: string; description?: string }>)[path];
const fallback = resolvePageSeo(path);
const seo = mapped ?? { title: own?.title || fallback.title, description: own?.description || fallback.description };
---
<PublicPageLayout title={seo.title} description={seo.description} noindexOverride={noindex} hideFooter={HIDE_FOOTER.includes(path)} hideCurrency={FOCUSED.includes(path)}>
  {view === 'AboutPage' && <AboutPage />}
  {view === 'AboutReframeVisualsPage' && <AboutReframeVisualsPage />}
  {view === 'ReframeVisualsServicesPage' && <ReframeVisualsServicesPage />}
  {view === 'HowItWorksPage' && <HowItWorksPage />}
  {view === 'PlatformPage' && <PlatformPage />}
  {view === 'PolicyPage' && <PolicyPage />}
  {view === 'CaseStudiesHubPage' && <CaseStudiesHubPage />}
  {view === 'ResourcesPage' && <ResourcesPage />}
  {view === 'ComparisonPage' && <ComparisonPage />}
  {view === 'CaseStudyDetailPage' && <CaseStudyDetailPage />}
  {view === 'InsightAndTrustPage' && <InsightAndTrustPage />}
  {view === 'ServicesPage' && <ServicesPage />}
  {view === 'PricingPage' && <PricingPage />}
  {view === 'PortfolioPage' && <PortfolioPage />}
  {view === 'TestimonialsPage' && <TestimonialsPage />}
  {view === 'AIProductVisualsPage' && <AIProductVisualsPage />}
  {view === 'FreeTrialPage' && <FreeTrialPage />}
  {view === 'StartPage' && <StartPage />}
  {view === 'PilotBatchPage' && <PilotBatchPage />}
  {view === 'BookMeetingPage' && <BookMeetingPage />}
  {view === 'ContactPage' && <ContactPage />}
  {view === 'QuoteBuilderPage' && <QuoteBuilderPage />}
  {view === 'ExpansionPage' && <ExpansionPage />}
</PublicPageLayout>
