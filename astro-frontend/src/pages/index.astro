---
import PublicPageLayout from '../layouts/PublicPageLayout.astro';
import LandingPage from '../views/LandingPage.astro';
import { SEO_META_BY_PATH } from '../data/seoMeta';
import { faqSchema, howToSchema, orgSchema, priceSchema, websiteSchema, softwareAppSchema } from '../sections/landing/landingSchemas';
const seo = SEO_META_BY_PATH['/'];
---
<PublicPageLayout title={seo.title} description={seo.description} jsonLd={[faqSchema, orgSchema, websiteSchema, priceSchema, howToSchema, softwareAppSchema]}>
  <LandingPage />
</PublicPageLayout>
