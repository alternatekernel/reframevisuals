---
export const prerender = false;
import PublicPageLayout from '../../layouts/PublicPageLayout.astro';
import BlogPostPage from '../../views/BlogPostPage.astro';
import { absoluteCanonicalUrl } from '../../utils/seo';
import { loadBlogSeed, CACHE_CONTROL } from '../../lib/blogSeed';
import { BLOG_POSTS } from '../../data/insightsData';

const { slug } = Astro.params;
const seed = await loadBlogSeed();
const post = (seed?.posts ?? BLOG_POSTS).find((p) => p.slug === slug);
if (!post) {
  return Astro.rewrite('/404');
}
Astro.response.headers.set('Cache-Control', CACHE_CONTROL);
const title = post.metaTitle || `${post.title} | Reframe Visuals`;
const description = post.metaDescription || post.excerpt;
const canonical = absoluteCanonicalUrl(`/blog/${post.canonicalSlug || post.slug}`);
const keywords = (post.focusKeywords || '').split(',').map((k) => k.trim()).filter(Boolean);
const regions = (post.geoRegions || '').split(',').map((r) => r.trim()).filter(Boolean);
const hreflang = post.hreflang || 'en';
---
<PublicPageLayout title={title} description={description} canonical={canonical} ogImage={post.image}>
  <Fragment slot="head">
    {keywords.length > 0 && <meta name="keywords" content={keywords.join(', ')} />}
    <meta property="og:type" content="article" />
    <meta property="og:locale" content={hreflang.replace('-', '_')} />
    {regions.length > 0 && <meta name="geo.placename" content={regions.join(', ')} />}
    <link rel="alternate" hreflang={hreflang} href={canonical} />
    <link rel="alternate" hreflang="x-default" href={canonical} />
  </Fragment>
  <BlogPostPage post={post} />
</PublicPageLayout>
