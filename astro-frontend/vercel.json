{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "sin1"
  ],
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.reframevisuals.com"
        }
      ],
      "destination": "https://reframevisuals.com/:path*",
      "statusCode": 301
    },
    {
      "source": "/services/jewelry-retouch",
      "destination": "/jewelry-photo-retouching-service",
      "statusCode": 301
    },
    {
      "source": "/services/model-retouching",
      "destination": "/services/model-retouch",
      "statusCode": 301
    },
    {
      "source": "/services/jewelry-retouching",
      "destination": "/services/jewelry-retouch",
      "statusCode": 301
    },
    {
      "source": "/services/brand-alignment",
      "destination": "/services/retouching",
      "statusCode": 301
    },
    {
      "source": "/services/enterprise",
      "destination": "/services/ai-product-photography",
      "statusCode": 301
    },
    {
      "source": "/services/image-editing",
      "destination": "/services/retouching",
      "statusCode": 301
    },
    {
      "source": "/services/product-editing",
      "destination": "/services/retouching",
      "statusCode": 301
    },
    {
      "source": "/blog/support-shot-compositing-for-product-images",
      "destination": "/blog/support-images-in-product-photography",
      "statusCode": 301
    },
    {
      "source": "/insights/:slug",
      "destination": "/blog/:slug",
      "statusCode": 301
    },
    {
      "source": "/insights",
      "destination": "/blog",
      "statusCode": 301
    },
    {
      "source": "/support",
      "destination": "/contact",
      "statusCode": 301
    },
    {
      "source": "/sitemap_index.xml",
      "destination": "/sitemap.xml",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), hid=(), bluetooth=()"
        }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/spa-assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reframevisuals.com/api/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/admin",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/dashboard",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/portal/:path*",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/portal",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/order/:path*",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/order",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/login",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/signup",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/forgot-password",
      "destination": "/csr-shell.html"
    },
    {
      "source": "/reset-password",
      "destination": "/csr-shell.html"
    }
  ]
}