# Vercel API Environment Variables
# Copy this file to .env.local and fill in your values

# JWT Secret (REQUIRED - generate a strong random string)
# JWT Secret (REQUIRED - generate a strong random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-2026

# JWT Expiration
JWT_EXPIRES_IN=7d

# Database URL
# For SQLite (development):
DATABASE_URL="file:./server/prisma/dev.db"

# For MongoDB (production - when you migrate):
# DATABASE_URL="mongodb+srv://username:password@cluster.mongodb.net/reframe-cms?retryWrites=true&w=majority"

# Node Environment
NODE_ENV=production
PORT=3001

# Frontend Configuration
FRONTEND_URL=https://reframevisuals.com
# Comma-separated extra CORS origins for staging/testing; keep empty in strict production.
CORS_ALLOWED_ORIGINS=
VITE_API_URL=https://reframevisuals.com/api
BASE_URL=https://reframevisuals.com
CANONICAL_BASE_URL=https://reframevisuals.com
CANONICAL_HOST=reframevisuals.com
REDIRECT_WWW_TO_APEX=true

# ─── Dropbox Configuration ─────────────────────────────────────
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
# Preferred for production. Dropbox access tokens expire; refresh tokens do not unless revoked.
DROPBOX_REFRESH_TOKEN=
# Optional temporary fallback only.
DROPBOX_ACCESS_TOKEN=
DROPBOX_UPLOAD_FOLDER="/Reframe Uploads"

# ─── Email (SMTP) ──────────────────────────────────────────────
# Required in production for support/admin outbound email. Without these,
# backend email endpoints fail closed instead of showing a false success.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Reframe Visuals <hello@reframevisuals.com>"
ADMIN_EMAIL="hello@reframevisuals.com"
# Resend inbound webhook signature secret for /api/support/inbound-webhook.
RESEND_WEBHOOK_SECRET=
# Set in production to create/ensure the admin dashboard user on startup.
ADMIN_PASSWORD=

# ─── Notification Configuration ───────────────────────────────
ADMIN_NOTIFY_EMAIL="hello@reframevisuals.com"
ADMIN_DASHBOARD_URL="https://reframevisuals.com/dashboard"

# Discord Notifications
# DISCORD_WEBHOOK_URL mirrors all Telegram notification categories into one Discord channel.
# Optional topic-specific webhooks override the default for that category.
DISCORD_WEBHOOK_URL=
DISCORD_ORDER_WEBHOOK=
DISCORD_URGENT_WEBHOOK=
DISCORD_PAYMENTS_WEBHOOK=
DISCORD_LEADS_WEBHOOK=
DISCORD_CHAT_WEBHOOK=
DISCORD_SYSTEM_WEBHOOK=

# Telegram Notifications & Chat
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_TOPIC_URGENT_ID=
TELEGRAM_TOPIC_ORDERS_ID=
TELEGRAM_TOPIC_PAYMENTS_ID=
TELEGRAM_TOPIC_LEADS_ID=
TELEGRAM_TOPIC_CHAT_ID=
TELEGRAM_TOPIC_SYSTEM_ID=

# Slack Notifications & Chat (unified bot)
# All notification categories go to one channel. SLACK_SIGNING_SECRET is
# required for two-way live chat (admin thread replies → customer).
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_DEFAULT_CHANNEL=

# Google OAuth — used for both Search Console and the Portal "Sign in with Google".
# OAuth 2.0 Web Client ID from https://console.cloud.google.com (APIs & Services → Credentials).
# Authorized JS origins must include your frontend URL(s). The frontend needs the same
# value exposed as VITE_GOOGLE_CLIENT_ID (see frontend/.env.example).
GOOGLE_CLIENT_ID=
